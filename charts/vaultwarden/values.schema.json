{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumeName": { "type": "string" },
        "volumePath": { "type": "string" },
        "nodeLabel": { "type": "string" }
      },
      "required": ["enabled", "volumeName", "volumePath", "nodeLabel"]
    },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["traefik", "published", "none"] },
        "network": { "type": "string" }
      },
      "required": ["mode", "network"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "tls": { "type": "boolean" }
      },
      "required": ["host", "tls"]
    },
    "domain": { "type": "string" },
    "traefik": {
      "type": "object",
      "properties": {
        "certResolver": { "type": "string" },
        "entrypoints": {
          "type": "object",
          "properties": {
            "http": { "type": "string" },
            "https": { "type": "string" }
          },
          "required": ["http", "https"]
        },
        "routerName": { "type": "string" },
        "constraintLabel": { "type": "string" },
        "redirectMiddleware": { "type": "string" }
      },
      "required": ["certResolver", "entrypoints", "routerName", "constraintLabel", "redirectMiddleware"]
    },
    "publish": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mode": { "type": "string", "enum": ["ingress", "host"] }
      },
      "required": ["port", "mode"]
    },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["port"]
    },
    "database": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["sqlite", "postgres", "mysql"] },
        "postgres": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "passwordSecretName": { "type": "string" },
            "network": { "type": "string" },
            "sslMode": { "type": "string" }
          },
          "required": ["host", "port", "name", "username", "passwordSecretName", "network", "sslMode"]
        },
        "mysql": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "passwordSecretName": { "type": "string" },
            "network": { "type": "string" }
          },
          "required": ["host", "port", "name", "username", "passwordSecretName", "network"]
        }
      },
      "required": ["type", "postgres", "mysql"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "adminToken": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "required": ["enabled", "secretName"]
        }
      },
      "required": ["adminToken"]
    },
    "smtp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "from": { "type": "string" },
        "fromName": { "type": "string" },
        "username": { "type": "string" },
        "security": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 1 },
        "password": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          },
          "required": ["enabled", "secretName"]
        }
      },
      "required": ["enabled", "host", "port", "from", "fromName", "username", "security", "timeout", "password"]
    },
    "app": {
      "type": "object",
      "properties": {
        "websocketsEnabled": { "type": "boolean" },
        "signupsAllowed": { "type": "boolean" },
        "rocketWorkers": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string" }
      },
      "required": ["websocketsEnabled", "signupsAllowed", "rocketWorkers", "logLevel"]
    },
    "extraEnv": { "type": "object" },
    "placement": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["constraints"]
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "memory": { "type": "string" }
          },
          "required": ["memory"]
        }
      },
      "required": ["limits"]
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "timeout": { "type": "string" },
        "retries": { "type": "integer", "minimum": 1 },
        "startPeriod": { "type": "string" },
        "monitor": { "type": "string" }
      },
      "required": ["enabled", "interval", "timeout", "retries", "startPeriod", "monitor"]
    },
    "labels": { "type": "object" }
  }
}
