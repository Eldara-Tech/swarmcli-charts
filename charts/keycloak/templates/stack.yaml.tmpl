version: "3.9"

{{- /* Exposure mode drives networks, ports, labels and the public scheme. */}}
{{- $mode := .Values.exposure.mode }}
{{- $proxied := or (eq $mode "traefik") (eq $mode "none") }}
{{- $selfTLS := and (eq $mode "published") .Values.publish.tls.enabled }}
{{- $publicTLS := ternary .Values.publish.tls.enabled .Values.ingress.tls (eq $mode "published") }}
{{- $scheme := ternary "https" "http" $publicTLS }}

services:

  keycloak:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

    networks:
{{- if $proxied }}
      - {{ .Values.exposure.network }}
{{- end }}
      - {{ .Values.database.network }}

{{- if eq $mode "published" }}
    ports:
      - target: {{ ternary 8443 8080 $selfTLS }}
        published: {{ .Values.publish.port }}
        protocol: tcp
        mode: {{ .Values.publish.mode }}
{{- end }}

    secrets:
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.admin.passwordSecretName }}
{{- if $selfTLS }}
      - {{ .Values.publish.tls.certSecretName }}
      - {{ .Values.publish.tls.keySecretName }}
{{- end }}

    # All non-secret config is passed via env. The DB + admin passwords are NOT here:
    # kc.sh has no *_FILE support (keycloak#10816), so they are read from the mounted
    # secret files by the entrypoint wrapper below and never appear in the compose
    # file or env. (The TLS cert/key, by contrast, are plain file paths Keycloak reads
    # natively, so KC_HTTPS_*_FILE point straight at the mounted secrets.)
    environment:
      KC_DB: {{ .Values.database.vendor | quote }}
{{- if .Values.database.url }}
      KC_DB_URL: {{ .Values.database.url | quote }}
{{- else }}
      KC_DB_URL_HOST: {{ .Values.database.host | quote }}
      KC_DB_URL_PORT: {{ .Values.database.port | quote }}
      KC_DB_URL_DATABASE: {{ .Values.database.database | quote }}
{{- end }}
      KC_DB_USERNAME: {{ .Values.database.username | quote }}
      KC_BOOTSTRAP_ADMIN_USERNAME: {{ .Values.admin.username | quote }}
{{- if eq $mode "published" }}
      # Direct publish: the public URL carries the published port, so KC_HOSTNAME must
      # include it or Keycloak emits wrong redirect/issuer URLs.
      KC_HOSTNAME: {{ printf "%s://%s:%v" $scheme .Values.ingress.host .Values.publish.port | quote }}
{{- else }}
      KC_HOSTNAME: {{ printf "%s://%s" $scheme .Values.ingress.host | quote }}
{{- end }}
      KC_HEALTH_ENABLED: "true"
{{- if $proxied }}
      # Behind a reverse proxy that terminates TLS: trust its X-Forwarded-* headers
      # and serve plain HTTP on the backend.
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
{{- else if $selfTLS }}
      # Keycloak terminates TLS from the mounted cert/key. Keep the management port
      # (9000, health) on plain HTTP so the /dev/tcp healthcheck still works.
      KC_HTTPS_CERTIFICATE_FILE: /run/secrets/{{ .Values.publish.tls.certSecretName }}
      KC_HTTPS_CERTIFICATE_KEY_FILE: /run/secrets/{{ .Values.publish.tls.keySecretName }}
      KC_HTTP_MANAGEMENT_SCHEME: http
{{- else }}
      # Direct plain HTTP publish (no proxy, no TLS).
      KC_HTTP_ENABLED: "true"
{{- end }}

    # kc.sh is the image ENTRYPOINT, so override it with a bash wrapper that loads the
    # two passwords from their mounted secret files via bash's `$(< file)` builtin
    # (no `cat`), exports them, then exec's kc.sh. `$$` is the compose escape for a
    # literal `$`, so deploy-time interpolation yields a real `$(< ...)` for the shell.
    entrypoint:
      - /bin/bash
      - -c
    command:
      - |-
        export KC_DB_PASSWORD="$$(< /run/secrets/{{ .Values.database.passwordSecretName }})"
        export KC_BOOTSTRAP_ADMIN_PASSWORD="$$(< /run/secrets/{{ .Values.admin.passwordSecretName }})"
        exec /opt/keycloak/bin/kc.sh {{ .Values.mode }}

{{- if .Values.healthcheck.enabled }}
    # Health lives on the management port (9000). The image has no curl, so probe
    # /health/ready over bash /dev/tcp and assert a 200 status line. `$$status`
    # escapes the compose `$` so the shell sees `$status` at runtime.
    healthcheck:
      test:
        - CMD
        - /bin/bash
        - -c
        - |-
          exec 3<>/dev/tcp/127.0.0.1/9000 || exit 1
          printf 'GET /health/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3
          read -r status <&3
          [[ "$$status" == *" 200 "* ]]
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.replicas }}
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- with .Values.resources.limits.memory }}
      resources:
        limits:
          memory: {{ . | quote }}
{{- end }}
      restart_policy:
        condition: any
{{- if or (eq $mode "traefik") .Values.labels }}
      labels:
{{- if eq $mode "traefik" }}
        - "traefik.enable=true"
        - "traefik.docker.network={{ .Values.exposure.network }}"
        # HTTP router
        - "traefik.http.routers.{{ .Release.Name }}-http.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ .Release.Name }}-http.entrypoints={{ .Values.traefik.entrypoints.http }}"
{{- if .Values.ingress.tls }}
        # Redirect plain HTTP to HTTPS, then terminate TLS on the HTTPS router.
        - "traefik.http.routers.{{ .Release.Name }}-http.middlewares=redirect-to-https@file"
        - "traefik.http.routers.{{ .Release.Name }}-https.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ .Release.Name }}-https.entrypoints={{ .Values.traefik.entrypoints.https }}"
        - "traefik.http.routers.{{ .Release.Name }}-https.tls=true"
        - "traefik.http.routers.{{ .Release.Name }}-https.tls.certresolver={{ .Values.traefik.certResolver }}"
{{- end }}
        - "traefik.http.services.{{ .Release.Name }}.loadbalancer.server.port={{ .Values.service.port }}"
{{- end }}
{{- range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}

secrets:
  {{ .Values.database.passwordSecretName }}:
    external: true
  {{ .Values.admin.passwordSecretName }}:
    external: true
{{- if $selfTLS }}
  {{ .Values.publish.tls.certSecretName }}:
    external: true
  {{ .Values.publish.tls.keySecretName }}:
    external: true
{{- end }}

networks:
{{- if $proxied }}
  {{ .Values.exposure.network }}:
    external: true
{{- end }}
  {{ .Values.database.network }}:
    external: true
