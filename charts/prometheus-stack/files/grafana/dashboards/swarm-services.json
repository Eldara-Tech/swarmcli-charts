        "query": {
          "query": "label_values(container_last_seen{container_label_com_docker_swarm_service_name!=\"\", node=~\"$node\"}, container_label_com_docker_stack_namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(container_last_seen{container_label_com_docker_swarm_service_name!=\"\", node=~\"$node\"}, container_label_com_docker_stack_namespace)",
