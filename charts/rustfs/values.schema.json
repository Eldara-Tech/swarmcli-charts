{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "mode": {
      "description": "standalone (one service, one drive) or distributed (cluster.peers services, erasure-coded). Chosen at install: changing it on an existing release does not convert the data.",
      "type": "string", "enum": ["standalone", "distributed"]
    },
    "cluster": {
      "description": "Distributed mode only.",
      "type": "object",
      "properties": {
        "peers": {
          "description": "Peers, one Swarm service each; RustFS's multi-node guide requires at least 4. Fixed at install.",
          "type": "integer", "minimum": 4
        },
        "drivesPerPeer": {
          "description": "Drives per peer. More than 1 needs persistence.volumePaths, one host path per drive on a disk of its own. Fixed at install.",
          "type": "integer", "minimum": 1
        }
      }
    },
    "s3": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "accessKeySecret": { "type": "string", "minLength": 1 },
        "secretKeySecret": { "type": "string", "minLength": 1 }
      }
    },
    "console": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "exposure": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["none", "traefik", "published"] }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "tls": { "type": "boolean" }
          }
        },
        "publish": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "mode": { "type": "string", "enum": ["ingress", "host"] }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "configUrl": { "type": "string" },
            "allowPrivateIdp": { "type": "boolean" },
            "clientId": { "type": "string", "minLength": 1 },
            "clientSecretSecret": { "type": "string", "minLength": 1 },
            "browserUrl": { "type": "string" },
            "displayName": { "type": "string", "minLength": 1 },
            "scopes": { "type": "string" },
            "groupsClaim": { "type": "string" },
            "rolesClaim": { "type": "string" },
            "emailClaim": { "type": "string" },
            "usernameClaim": { "type": "string" }
          }
        }
      }
    },
    "buckets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
      "uniqueItems": true
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumeName": { "type": "string", "pattern": "^[^/]+$" },
        "volumePath": { "type": "string" },
        "nodeLabel": { "type": "string" },
        "volumePrefix": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
        "volumePaths": {
          "description": "Distributed mode: one entry per peer, in peer order, each a list of cluster.drivesPerPeer absolute host paths (a single path may be a string), or [] for named volumes.",
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" } }
            ]
          }
        },
        "nodeLabelPrefix": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "traefik", "published"] },
        "network": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "tls": { "type": "boolean" }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "certResolver": { "type": "string" },
        "routerName": { "type": "string" },
        "constraintLabel": { "type": "string" },
        "redirectMiddleware": { "type": "string" },
        "idleTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "entrypoints": {
          "type": "object",
          "properties": {
            "http": { "type": "string" },
            "https": { "type": "string" }
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mode": { "type": "string", "enum": ["ingress", "host"] }
      }
    },
    "nofile": { "type": "integer", "minimum": 0 },
    "extraEnv": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "metrics": {
      "description": "An OpenTelemetry Collector RustFS, every peer of it, pushes its metrics to, labelled for Docker Swarm service discovery.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "network": {
          "description": "External overlay the collector shares with Prometheus.",
          "type": "string", "minLength": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "description": "The collector's memory limit; keep it at 256M or more, above its memory_limiter's 200 MiB.",
                  "type": "string", "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "timeout": { "type": "string" },
        "retries": { "type": "integer", "minimum": 1 },
        "startPeriod": { "type": "string" },
        "monitor": { "type": "string" }
      }
    },
    "stopGracePeriod": { "type": "string" },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        },
        "reservations": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        }
      }
    },
    "labels": { "type": "object" }
  }
}
