{{- /* Superset is STATELESS here: the metadata DB and Redis are external, so there is no
       volume and no node pin. Four services: a one-shot init (migrations/roles/admin), the
       gunicorn app, and — while celery.enabled — a Celery worker and a single beat. */}}
{{- $mode := .Values.exposure.mode }}
{{- $proxied := or (eq $mode "traefik") (eq $mode "none") }}
{{- $publicTLS := and $proxied .Values.ingress.tls }}
{{- $router := .Values.traefik.routerName | default .Release.Name }}
{{- $image := printf "%s:%s" .Values.image.repository (.Values.image.tag | default .Chart.AppVersion) }}
{{- $port := .Values.service.port }}
{{- $mysql := eq .Values.database.dialect "mysql" }}
{{- /* PyMySQL, not mysqlclient: the lean image has no compiler, so only a pure-Python driver
       can be installed at start. A derived image with mysqlclient can point database.sqlalchemyUri
       at a mysql+mysqldb:// URI instead. */}}
{{- $driver := ternary "mysql+pymysql" "postgresql+psycopg2" $mysql }}

{{- /* Every service sits on the DB + Redis overlays (and the optional data-source overlay);
       the app additionally joins the ingress overlay in proxied modes. uniq: an operator may
       legitimately point several of these at ONE overlay, and a duplicate entry is invalid. */}}
{{- $nets := list .Values.database.network .Values.redis.network }}
{{- if .Values.dataNetwork.enabled }}
{{-   $nets = append $nets .Values.dataNetwork.name }}
{{- end }}
{{- $nets = $nets | uniq }}
{{- $appNets := ternary (append $nets .Values.exposure.network | uniq) $nets $proxied }}

{{- /* ---------------------------------------------------------------------------------------
       superset_config.py. Superset 5 has NO env-var configuration mechanism, and a chart cannot
       create a Swarm config object — so the chart renders the config as Python, base64s it into
       one env var, and each service's entrypoint decodes it to SUPERSET_CONFIG_PATH.

       base64 rather than a heredoc because `docker stack deploy` interpolates `$`/`${…}` in the
       manifest and config.extraPy is arbitrary operator Python: encoded, no user content can
       break the manifest or the shell. The config is not secret — it READS secrets. It calls
       _secret() at import time, so the passwords live only inside the Python process: never in
       the compose file, never in `docker inspect`, never in the container's environment.
       --------------------------------------------------------------------------------------- */}}
{{- $secretName := .Values.secretKey.secretName }}
{{- $py := list
      "# Generated by the swarmcli superset chart. Do not edit in the container."
      "import json"
      "from urllib.parse import quote"
      "from cachelib.redis import RedisCache"
      "from celery.schedules import crontab"
      ""
      "def _secret(name):"
      "    with open('/run/secrets/' + name) as f:"
      "        return f.read().strip()"
      ""
}}
{{- $py = append $py (printf "SECRET_KEY = _secret(%q)" $secretName) }}
{{- $py = append $py "" }}
{{- $py = append $py "# --- metadata database ---" }}
{{- $py = append $py (printf "_DB_PW = quote(_secret(%q), safe='')" .Values.database.passwordSecretName) }}
{{- if .Values.database.sqlalchemyUri }}
{{-   $py = append $py (printf "SQLALCHEMY_DATABASE_URI = %q.replace('{password}', _DB_PW)" .Values.database.sqlalchemyUri) }}
{{- else }}
{{-   $py = append $py (printf "SQLALCHEMY_DATABASE_URI = %q + _DB_PW + %q"
        (printf "%s://%s:" $driver .Values.database.username)
        (printf "@%s:%v/%s" .Values.database.host .Values.database.port .Values.database.database)) }}
{{- end }}
{{- $py = append $py "" }}
{{- $py = append $py "# --- redis: celery broker/results, caches, rate-limit storage ---" }}
{{- if .Values.redis.auth.enabled }}
{{-   $py = append $py (printf "_R_PW = _secret(%q)" .Values.redis.auth.secretName) }}
{{-   $py = append $py (printf "_R = 'redis://:' + quote(_R_PW, safe='') + %q" (printf "@%s:%v" .Values.redis.host .Values.redis.port)) }}
{{- else }}
{{-   $py = append $py "_R_PW = None" }}
{{-   $py = append $py (printf "_R = %q" (printf "redis://%s:%v" .Values.redis.host .Values.redis.port)) }}
{{- end }}
{{- $py = append $py "" }}
{{- $py = append $py "def _cache(db, prefix):" }}
{{- $py = append $py "    return {'CACHE_TYPE': 'RedisCache', 'CACHE_REDIS_URL': _R + '/' + str(db)," }}
{{- $py = append $py "            'CACHE_DEFAULT_TIMEOUT': 300, 'CACHE_KEY_PREFIX': prefix}" }}
{{- $py = append $py "" }}
{{- $cacheDB := .Values.redis.db.cache }}
{{- $py = append $py (printf "CACHE_CONFIG = _cache(%v, 'superset_cache_')" $cacheDB) }}
{{- $py = append $py (printf "DATA_CACHE_CONFIG = _cache(%v, 'superset_data_')" $cacheDB) }}
{{- $py = append $py (printf "FILTER_STATE_CACHE_CONFIG = _cache(%v, 'superset_filter_')" $cacheDB) }}
{{- $py = append $py (printf "EXPLORE_FORM_DATA_CACHE_CONFIG = _cache(%v, 'superset_form_')" $cacheDB) }}
{{- $py = append $py "" }}
{{- /* Async SQL Lab payloads. Redis, NOT the default FileSystemCache under SUPERSET_HOME —
       that would need a volume shared by the app and the workers, which a Swarm named volume
       (node-local) cannot be. */}}
{{- $py = append $py (printf "RESULTS_BACKEND = RedisCache(host=%q, port=%v, password=_R_PW, db=%v, key_prefix='superset_results_')"
      .Values.redis.host .Values.redis.port .Values.redis.db.results) }}
{{- /* The image bakes SUPERSET_ENV=production, which turns rate limiting ON with flask-limiter's
       in-memory storage — per-replica, and lost on restart. Point it at Redis. */}}
{{- $py = append $py (printf "RATELIMIT_STORAGE_URI = _R + '/%v'" .Values.redis.db.rateLimit) }}
{{- $py = append $py "" }}
{{- $py = append $py "# --- celery (default CELERY_CONFIG is a SQLite broker; it must be replaced) ---" }}
{{- $py = append $py "class CeleryConfig:" }}
{{- $py = append $py (printf "    broker_url = _R + '/%v'" .Values.redis.db.broker) }}
{{- $py = append $py (printf "    result_backend = _R + '/%v'" .Values.redis.db.results) }}
{{- $py = append $py "    imports = ('superset.sql_lab', 'superset.tasks.scheduler', 'superset.tasks.cache')" }}
{{- $py = append $py "    worker_prefetch_multiplier = 1" }}
{{- $py = append $py "    broker_connection_retry_on_startup = True" }}
{{- $py = append $py "    beat_schedule = {" }}
{{- $py = append $py "        'reports.scheduler': {'task': 'reports.scheduler'," }}
{{- $py = append $py "                              'schedule': crontab(minute='*', hour='*')}," }}
{{- $py = append $py "        'reports.prune_log': {'task': 'reports.prune_log'," }}
{{- $py = append $py "                              'schedule': crontab(minute=10, hour=0)}," }}
{{- $py = append $py "    }" }}
{{- $py = append $py "" }}
{{- $py = append $py "CELERY_CONFIG = CeleryConfig" }}
{{- $py = append $py "" }}
{{- $py = append $py "# --- exposure ---" }}
{{- if $proxied }}
{{- /* Behind a TLS-terminating proxy: trust its X-Forwarded-* headers. Without this Flask sees
       plain http and builds wrong CSRF / OAuth redirect URIs. */}}
{{-   $py = append $py "ENABLE_PROXY_FIX = True" }}
{{- end }}
{{- $py = append $py "SESSION_COOKIE_HTTPONLY = True" }}
{{- $py = append $py "SESSION_COOKIE_SAMESITE = 'Lax'" }}
{{- if $publicTLS }}
{{-   $py = append $py "SESSION_COOKIE_SECURE = True" }}
{{- end }}
{{- $py = append $py "" }}
{{- $py = append $py (printf "FEATURE_FLAGS = json.loads(%q)" (.Values.featureFlags | toJson)) }}
{{- if .Values.oidc.enabled }}
{{-   $py = append $py "" }}
{{-   $py = append $py "# --- OIDC / OAuth single sign-on (Flask-AppBuilder; needs Authlib) ---" }}
{{-   $py = append $py "from flask_appbuilder.security.manager import AUTH_OAUTH" }}
{{-   $py = append $py "AUTH_TYPE = AUTH_OAUTH" }}
{{-   $py = append $py (printf "AUTH_USER_REGISTRATION = %s" (ternary "True" "False" .Values.oidc.userRegistration)) }}
{{-   $py = append $py (printf "AUTH_USER_REGISTRATION_ROLE = %q" .Values.oidc.registrationRole) }}
{{-   $py = append $py (printf "AUTH_ROLES_SYNC_AT_LOGIN = %s" (ternary "True" "False" .Values.oidc.rolesSyncAtLogin)) }}
{{-   $py = append $py (printf "AUTH_ROLES_MAPPING = json.loads(%q)" (.Values.oidc.rolesMapping | toJson)) }}
{{-   $py = append $py "OAUTH_PROVIDERS = [{" }}
{{-   $py = append $py (printf "    'name': %q," .Values.oidc.name) }}
{{-   $py = append $py (printf "    'icon': %q," .Values.oidc.icon) }}
{{-   $py = append $py "    'token_key': 'access_token'," }}
{{-   $py = append $py "    'remote_app': {" }}
{{-   $py = append $py (printf "        'client_id': %q," .Values.oidc.clientId) }}
{{-   $py = append $py (printf "        'client_secret': _secret(%q)," .Values.oidc.clientSecretSecretName) }}
{{-   $py = append $py (printf "        'client_kwargs': {'scope': %q}," .Values.oidc.scope) }}
{{-   $py = append $py (printf "        'server_metadata_url': %q," .Values.oidc.serverMetadataUrl) }}
{{-   $py = append $py "    },"  }}
{{-   $py = append $py "}]" }}
{{- end }}
{{- with .Values.config.extraPy }}
{{-   $py = append $py "" }}
{{-   $py = append $py "# --- config.extraPy (operator-supplied; last word) ---" }}
{{-   $py = append $py . }}
{{- end }}
{{- $configB64 := $py | join "\n" | b64enc }}

{{- /* ---------------------------------------------------------------------------------------
       Entrypoint. The image ENTRYPOINT/CMD is run-server.sh, so every service overrides it with
       a small sh wrapper: install the driver (the lean image has none), materialise the config,
       wait for the database, exec. `$$` is the compose escape for a literal `$`.
       --------------------------------------------------------------------------------------- */}}
{{- $pkgs := list }}
{{- if .Values.python.installDrivers }}
{{-   $pkgs = append $pkgs (ternary "PyMySQL==1.1.1" "psycopg2-binary==2.9.6" $mysql) }}
{{-   if .Values.oidc.enabled }}
{{-     $pkgs = append $pkgs "Authlib==1.6.5" }}
{{-   end }}
{{- end }}
{{- range .Values.python.extraPackages }}
{{-   $pkgs = append $pkgs . }}
{{- end }}
{{- $idx := "" }}
{{- with .Values.python.indexUrl }}
{{-   $idx = printf " --index-url %s" . }}
{{- end }}
{{- $pre := list "set -e" }}
{{- if $pkgs }}
{{- /* --target, not a venv install: the image runs as the non-root `superset` user, so this
         is the only place it can write. pip first (the proven path on this image), uv as the
         fallback for an image that ships only uv. */}}
{{-   $pre = append $pre (printf "echo 'installing python packages: %s'" (join " " $pkgs)) }}
{{-   $pre = append $pre (printf "if command -v pip >/dev/null 2>&1; then pip install --no-cache-dir --target /tmp/pip-packages%s %s; elif command -v uv >/dev/null 2>&1; then uv pip install --no-cache --target /tmp/pip-packages%s %s; else echo 'neither pip nor uv is present in this image — set python.installDrivers: false and bake the drivers in' >&2; exit 1; fi" $idx (join " " $pkgs) $idx (join " " $pkgs)) }}
{{- end }}
{{- $pre = append $pre "printf %s \"$$SUPERSET_CONFIG_B64\" | base64 -d > /tmp/superset_config.py" }}
{{- /* Probes run through the generated config, so they reuse its URI (and its password) without
       ever putting a credential in the environment. */}}
{{- $probe := "import sys; sys.path.insert(0, '/tmp'); import superset_config as c; from sqlalchemy import create_engine; create_engine(c.SQLALCHEMY_DATABASE_URI).connect().exec_driver_sql" }}
{{- $waitDB := printf "until python -c \"%s('select 1')\" >/dev/null 2>&1; do echo 'waiting for the metadata database...'; sleep 5; done" $probe }}
{{- /* Swarm has no depends_on, and Superset's alembic migrations take no lock: app/worker/beat
       must not run against a half-migrated database, so they block until alembic_version exists.
       A stack whose init never succeeds then fails LOUDLY (the healthcheck's start_period
       expires and the task is restarted) instead of quietly serving 500s. */}}
{{- $waitInit := printf "until python -c \"%s('select 1 from alembic_version')\" >/dev/null 2>&1; do echo 'waiting for superset-init to migrate the database...'; sleep 5; done" $probe }}

{{- /* Shared environment. Superset 5 reads NO configuration from env (the SUPERSET__* scheme
       does not exist in it) — these are the few vars the image itself reads, plus the config
       blob. PYTHONPATH/SUPERSET_CONFIG_PATH must live here, not just be exported by the
       entrypoint: the healthchecks run in a fresh shell that only sees `environment:`. */}}
{{- $baseEnv := dict
      "SUPERSET_CONFIG_PATH" "/tmp/superset_config.py"
      "PYTHONPATH" "/tmp/pip-packages:/app/pythonpath"
      "SUPERSET_PORT" (printf "%v" $port)
      "SUPERSET_CONFIG_B64" $configB64
}}
{{- /* mergeOverwrite: later sources win, so extraEnv always has the last word. */}}
{{- $appEnv := mergeOverwrite (dict) $baseEnv (dict
      "SERVER_WORKER_AMOUNT" (printf "%v" .Values.server.workers)
      "SERVER_THREADS_AMOUNT" (printf "%v" .Values.server.threads)
      "GUNICORN_TIMEOUT" (printf "%v" .Values.server.timeout)
      "GUNICORN_LOGLEVEL" (printf "%v" .Values.server.logLevel)
    ) .Values.extraEnv }}
{{- $workerEnv := mergeOverwrite (dict) $baseEnv (dict "CELERYD_CONCURRENCY" (printf "%v" .Values.celery.worker.concurrency)) .Values.extraEnv }}
{{- $initEnv := mergeOverwrite (dict) $baseEnv (dict "SUPERSET_LOAD_EXAMPLES" (ternary "yes" "no" .Values.init.loadExamples)) .Values.extraEnv }}
{{- $beatEnv := mergeOverwrite (dict) $baseEnv .Values.extraEnv }}

{{- /* The data-node pin of the stateful charts has no analogue here (no volume);
       placement.constraints carries the operator's extra constraints only. */}}
version: "3.9"

services:

{{- if .Values.init.enabled }}

  {{- /* One-shot: runs to completion and is not restarted (a completed task leaves
         desired-state Shutdown). on-failure covers a database that is not up yet. */}}
  init:
    image: {{ $image }}

    networks:
{{ toYaml $nets | indent 6 }}

    secrets:
      - {{ $secretName }}
      - {{ .Values.database.passwordSecretName }}
{{- if .Values.redis.auth.enabled }}
      - {{ .Values.redis.auth.secretName }}
{{- end }}
{{- if .Values.init.admin.enabled }}
      - {{ .Values.init.admin.passwordSecretName }}
{{- end }}
{{- if .Values.oidc.enabled }}
      - {{ .Values.oidc.clientSecretSecretName }}
{{- end }}

    environment:
{{ toYaml $initEnv | indent 6 }}

    entrypoint:
      - /bin/sh
      - -c
    command:
      - |-
{{ join "\n" $pre | indent 8 }}
        {{ $waitDB }}
        superset db upgrade
        superset init
{{- if .Values.init.admin.enabled }}
        {{- /* create-admin errors when the user already exists, which is the normal case on
               every redeploy after the first — tolerate it. */}}
        superset fab create-admin --username {{ .Values.init.admin.username | quote }} \
          --firstname {{ .Values.init.admin.firstName | quote }} \
          --lastname {{ .Values.init.admin.lastName | quote }} \
          --email {{ .Values.init.admin.email | quote }} \
          --password "$$(cat /run/secrets/{{ .Values.init.admin.passwordSecretName }})" || true
{{- end }}
{{- if .Values.init.loadExamples }}
        superset load_examples
{{- end }}
        echo 'superset-init: done'

    {{- /* The image bakes an HTTP healthcheck (curl /health). init serves no HTTP, so the
           inherited check would fail it forever — disable it. */}}
    healthcheck:
      disable: true

    deploy:
      replicas: 1
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
      restart_policy:
        condition: on-failure
        delay: 10s
        max_attempts: 5
{{- end }}

  app:
    image: {{ $image }}

    networks:
{{ toYaml $appNets | indent 6 }}

{{- if eq $mode "published" }}
    ports:
      - target: {{ $port }}
        published: {{ .Values.publish.port }}
        protocol: tcp
        mode: {{ .Values.publish.mode }}
{{- end }}

    secrets:
      - {{ $secretName }}
      - {{ .Values.database.passwordSecretName }}
{{- if .Values.redis.auth.enabled }}
      - {{ .Values.redis.auth.secretName }}
{{- end }}
{{- if .Values.oidc.enabled }}
      - {{ .Values.oidc.clientSecretSecretName }}
{{- end }}

    environment:
{{ toYaml $appEnv | indent 6 }}

    entrypoint:
      - /bin/sh
      - -c
    command:
      - |-
{{ join "\n" $pre | indent 8 }}
        {{ $waitInit }}
        exec /usr/bin/run-server.sh

{{- if .Values.healthcheck.enabled }}
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://localhost:{{ $port }}/health || exit 1
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.replicas }}
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- if or .Values.resources.limits.memory .Values.resources.reservations.memory }}
      resources:
{{- with .Values.resources.limits.memory }}
        limits:
          memory: {{ . | quote }}
{{- end }}
{{- with .Values.resources.reservations.memory }}
        reservations:
          memory: {{ . | quote }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
{{- if or (eq $mode "traefik") .Values.labels }}
      labels:
{{- if eq $mode "traefik" }}
        - "traefik.enable=true"
        - "traefik.swarm.network={{ .Values.exposure.network }}"
        - "traefik.constraint-label={{ .Values.traefik.constraintLabel }}"
        # HTTP router
        - "traefik.http.routers.{{ $router }}-http.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-http.entrypoints={{ .Values.traefik.entrypoints.http }}"
{{- if .Values.ingress.tls }}
        # Redirect plain HTTP to HTTPS, then terminate TLS on the HTTPS router.
        - "traefik.http.routers.{{ $router }}-http.middlewares={{ .Values.traefik.redirectMiddleware }}"
        - "traefik.http.routers.{{ $router }}-https.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-https.entrypoints={{ .Values.traefik.entrypoints.https }}"
        - "traefik.http.routers.{{ $router }}-https.tls=true"
        - "traefik.http.routers.{{ $router }}-https.tls.certresolver={{ .Values.traefik.certResolver }}"
{{- end }}
        - "traefik.http.services.{{ $router }}.loadbalancer.server.port={{ $port }}"
{{- end }}
{{- range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}

{{- if .Values.celery.enabled }}

  worker:
    image: {{ $image }}

    networks:
{{ toYaml $nets | indent 6 }}

    secrets:
      - {{ $secretName }}
      - {{ .Values.database.passwordSecretName }}
{{- if .Values.redis.auth.enabled }}
      - {{ .Values.redis.auth.secretName }}
{{- end }}
{{- if .Values.oidc.enabled }}
      - {{ .Values.oidc.clientSecretSecretName }}
{{- end }}

    environment:
{{ toYaml $workerEnv | indent 6 }}

    entrypoint:
      - /bin/sh
      - -c
    command:
      - |-
{{ join "\n" $pre | indent 8 }}
        {{ $waitInit }}
        exec /app/docker/docker-bootstrap.sh worker

{{- if .Values.healthcheck.enabled }}
    {{- /* The worker serves no HTTP: ask Celery instead. `$$HOSTNAME` escapes the compose `$`. */}}
    healthcheck:
      test:
        - CMD-SHELL
        - celery -A superset.tasks.celery_app:app inspect ping -d celery@$$HOSTNAME
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.celery.worker.replicas }}
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- if or .Values.resources.limits.memory .Values.resources.reservations.memory }}
      resources:
{{- with .Values.resources.limits.memory }}
        limits:
          memory: {{ . | quote }}
{{- end }}
{{- with .Values.resources.reservations.memory }}
        reservations:
          memory: {{ . | quote }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any

{{- if .Values.celery.beat.enabled }}

  {{- /* The scheduler. EXACTLY one replica — a second beat double-fires every scheduled report
         — and stop-first on update so a rolling deploy never runs two at once. */}}
  beat:
    image: {{ $image }}

    networks:
{{ toYaml $nets | indent 6 }}

    secrets:
      - {{ $secretName }}
      - {{ .Values.database.passwordSecretName }}
{{- if .Values.redis.auth.enabled }}
      - {{ .Values.redis.auth.secretName }}
{{- end }}
{{- if .Values.oidc.enabled }}
      - {{ .Values.oidc.clientSecretSecretName }}
{{- end }}

    environment:
{{ toYaml $beatEnv | indent 6 }}

    entrypoint:
      - /bin/sh
      - -c
    command:
      - |-
{{ join "\n" $pre | indent 8 }}
        {{ $waitInit }}
        exec /app/docker/docker-bootstrap.sh beat

    {{- /* Beat has no health surface, and the image's baked HTTP healthcheck would fail it. */}}
    healthcheck:
      disable: true

    deploy:
      replicas: 1
      update_config:
        order: stop-first
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- if or .Values.resources.limits.memory .Values.resources.reservations.memory }}
      resources:
{{- with .Values.resources.limits.memory }}
        limits:
          memory: {{ . | quote }}
{{- end }}
{{- with .Values.resources.reservations.memory }}
        reservations:
          memory: {{ . | quote }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
{{- end }}
{{- end }}

secrets:
  {{ $secretName }}:
    external: true
  {{ .Values.database.passwordSecretName }}:
    external: true
{{- if .Values.redis.auth.enabled }}
  {{ .Values.redis.auth.secretName }}:
    external: true
{{- end }}
{{- if and .Values.init.enabled .Values.init.admin.enabled }}
  {{ .Values.init.admin.passwordSecretName }}:
    external: true
{{- end }}
{{- if .Values.oidc.enabled }}
  {{ .Values.oidc.clientSecretSecretName }}:
    external: true
{{- end }}

networks:
{{- range $appNets }}
  {{ . }}:
    external: true
{{- end }}
