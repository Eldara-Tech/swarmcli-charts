{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "replicas": { "type": "integer", "minimum": 1, "maximum": 1 },
    "auth": {
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string" }
      },
      "required": ["secretName"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumeName": { "type": "string" },
        "volumePath": { "type": "string" },
        "nodeLabel": { "type": "string" },
        "pgdata": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "external": { "type": "boolean" }
      },
      "required": ["name"]
    },
    "exposure": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp"] },
        "mode": { "type": "string", "enum": ["ingress", "host"] }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        }
      }
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "timeout": { "type": "string" },
        "retries": { "type": "integer", "minimum": 1 },
        "startPeriod": { "type": "string" },
        "monitor": { "type": "string" }
      }
    },
    "metrics": {
      "description": "A postgres_exporter beside the database, labelled for Docker Swarm service discovery.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        "username": {
          "description": "The exporter's role. A plain lower-case identifier: it is spliced into the start-up shell and the connection settings.",
          "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "secretName": { "type": "string", "minLength": 1 },
        "network": {
          "description": "External overlay the exporter shares with Prometheus.",
          "type": "string", "minLength": 1
        }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "labels": { "type": "object" }
  }
}
