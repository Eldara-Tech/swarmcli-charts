          "expr": "1 - elasticsearch_filesystem_data_available_bytes{stack=\"$stack\"} / elasticsearch_filesystem_data_size_bytes{stack=\"$stack\"}",
          "refId": "A",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
