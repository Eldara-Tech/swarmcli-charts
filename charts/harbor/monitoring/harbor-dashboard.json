{
  "title": "Harbor",
  "uid": "harbor",
  "description": "Harbor components, projects, core, job service, registry and processes from the metrics the harbor chart's metrics.enabled turns on, one release per stack. Ships with the harbor chart; derived from Harbor's contrib/grafana-dashboard/metrics-example.json (Apache-2.0).",
  "tags": [
    "harbor",
    "registry"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "stack",
        "label": "Release",
        "description": "Stack (com.docker.stack.namespace) of the Harbor exporter.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(harbor_task_scheduled_total, stack)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(harbor_task_scheduled_total, stack)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health",
      "description": "Harbor's overall status from its health API, as the exporter reads it (harbor_health): unhealthy while any component is.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(harbor_health{stack=\"$stack\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
