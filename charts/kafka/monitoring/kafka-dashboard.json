{
  "title": "Kafka clusters",
  "uid": "kafka",
  "description": "Kafka brokers, partition health, throughput and consumer group lag from the kafka_exporter, one cluster per stack. Ships with the kafka chart; panels after kafka_exporter's Kafka Exporter Overview (danielqsj/kafka_exporter) and Strimzi's Kafka Exporter dashboard (strimzi/strimzi-kafka-operator), both Apache-2.0.",
  "tags": [
    "kafka"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "stack",
        "label": "Cluster",
        "description": "Stack (com.docker.stack.namespace) of the kafka_exporter target.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kafka_brokers, stack)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(kafka_brokers, stack)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0
      },
      {
        "name": "topic",
        "label": "Topic",
        "description": "Topics of the cluster, for the throughput and consumer group panels.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kafka_topic_partitions{stack=\"$stack\"}, topic)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(kafka_topic_partitions{stack=\"$stack\"}, topic)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "consumergroup",
        "label": "Consumer group",
        "description": "Consumer groups of the cluster.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kafka_consumergroup_members{stack=\"$stack\"}, consumergroup)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(kafka_consumergroup_members{stack=\"$stack\"}, consumergroup)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "",
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Brokers",
      "description": "Brokers in the cluster metadata, as kafka_exporter sees it. Fewer than 3 cannot hold the default replication factor. With a majority of them lost the metadata freezes and still counts the last ones lost; with all lost no scrape completes, and this reads No data (KafkaUnreachable).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kafka_brokers{stack=\"$stack\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Offline partitions",
      "description": "Partitions no broker serves, so every read and write to them fails: reported without an offset by every scrape of the last 2 minutes, as KafkaPartitionsOffline counts them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(last_over_time(kafka_topic_partition_replicas{stack=\"$stack\"}[2m]) unless last_over_time(kafka_topic_partition_current_offset{stack=\"$stack\"}[2m])) or max(kafka_brokers{stack=\"$stack\"}) * 0",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Below min ISR",
      "description": "Partitions with a leader but fewer in-sync replicas than min.insync.replicas (2, or the replication factor if less): acks=all writes to them are refused, and acks=1 writes stay invisible to consumers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kafka_topic_partition_in_sync_replica{stack=\"$stack\"} < clamp_max(kafka_topic_partition_replicas{stack=\"$stack\"}, 2) and kafka_topic_partition_current_offset{stack=\"$stack\"}) or max(kafka_brokers{stack=\"$stack\"}) * 0",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Under-replicated",
      "description": "Partitions with fewer in-sync replicas than replicas that still take writes. Offline and below-min-ISR partitions are counted beside, not here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kafka_topic_partition_in_sync_replica{stack=\"$stack\"} < kafka_topic_partition_replicas{stack=\"$stack\"} and kafka_topic_partition_in_sync_replica{stack=\"$stack\"} >= clamp_max(kafka_topic_partition_replicas{stack=\"$stack\"}, 2) and kafka_topic_partition_current_offset{stack=\"$stack\"}) or max(kafka_brokers{stack=\"$stack\"}) * 0",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Not on preferred leader",
      "description": "Partitions not led by their first replica, usually since a broker restarted: their load sits on the other brokers until leadership moves back, which Kafka does by itself by default. Offline partitions count here too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kafka_topic_partition_leader_is_preferred{stack=\"$stack\"} == 0) or max(kafka_brokers{stack=\"$stack\"}) * 0",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Topics",
      "description": "Topics in the cluster, internal ones (__consumer_offsets) included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kafka_topic_partitions{stack=\"$stack\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Brokers and partitions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Partition health",
      "description": "Per topic, the partitions in each of the states the alerts report; a healthy topic draws no line.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (topic) (last_over_time(kafka_topic_partition_replicas{stack=\"$stack\"}[2m]) unless last_over_time(kafka_topic_partition_current_offset{stack=\"$stack\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{topic}} offline",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (topic) (kafka_topic_partition_in_sync_replica{stack=\"$stack\"} < clamp_max(kafka_topic_partition_replicas{stack=\"$stack\"}, 2) and kafka_topic_partition_current_offset{stack=\"$stack\"})",
          "refId": "B",
          "legendFormat": "{{topic}} below min ISR",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (topic) (kafka_topic_partition_in_sync_replica{stack=\"$stack\"} < kafka_topic_partition_replicas{stack=\"$stack\"} and kafka_topic_partition_in_sync_replica{stack=\"$stack\"} >= clamp_max(kafka_topic_partition_replicas{stack=\"$stack\"}, 2) and kafka_topic_partition_current_offset{stack=\"$stack\"})",
          "refId": "C",
          "legendFormat": "{{topic}} under-replicated",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Brokers",
      "description": "Brokers in the cluster metadata over time. A gap is a stretch in which no scrape completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kafka_brokers{stack=\"$stack\"})",
          "refId": "A",
          "legendFormat": "brokers",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Messages in per second",
      "description": "Messages appended to each topic, from the rate of its partitions' latest offsets. __consumer_offsets grows with every offset commit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{stack=\"$stack\", topic=~\"$topic\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{topic}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Partitions per topic",
      "description": "Partitions, replication factor and the fewest in-sync replicas of any partition, per topic, and the messages it retains (latest minus oldest offset, which overstates a compacted topic).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Topic",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (kafka_topic_partitions{stack=\"$stack\", topic=~\"$topic\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (topic) (kafka_topic_partition_replicas{stack=\"$stack\", topic=~\"$topic\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (topic) (kafka_topic_partition_in_sync_replica{stack=\"$stack\", topic=~\"$topic\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{stack=\"$stack\", topic=~\"$topic\"} - kafka_topic_partition_oldest_offset{stack=\"$stack\", topic=~\"$topic\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "topic": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "topic": "Topic",
              "Value #A": "Partitions",
              "Value #B": "Replication factor",
              "Value #C": "Fewest in sync",
              "Value #D": "Messages retained"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Consumer groups",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Lag by group and topic",
      "description": "Messages each group has yet to consume on each topic: the latest offsets minus the group's committed ones, over the partitions it has committed to. A healthy consumer's lag is a sawtooth between commits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag_sum{stack=\"$stack\", consumergroup=~\"$consumergroup\", topic=~\"$topic\"})",
          "refId": "A",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Lag trend",
      "description": "How fast each group's lag changes, over 10 minutes: above 0 it falls behind, below 0 it catches up. KafkaConsumerGroupLagGrowing fires once it has stayed behind for about half an hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
