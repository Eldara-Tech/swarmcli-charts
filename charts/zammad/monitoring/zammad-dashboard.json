    {
      "id": 16,
      "type": "timeseries",
      "title": "Thread pool rejections",
      "description": "Search and write requests refused because the pool's queue was full; the Zammad search or indexing job behind each one fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
