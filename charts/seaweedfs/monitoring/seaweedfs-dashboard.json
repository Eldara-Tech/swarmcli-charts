          "refId": "A",
          "legendFormat": "{{bucket}} in",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bucket) (rate(SeaweedFS_s3_bucket_traffic_sent_bytes_total{stack=\"$stack\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "{{bucket}} out",
          "range": true
        }
      ]
    },
