{{- /* The CROSS-FIELD invariants only. Single-field rules (peers is 3 or 5,
       exposure.mode is host, a volumePath is absolute) live in
       values.schema.json, which rejects them earlier and names the offending
       path; duplicating them here would be unreachable. What is left is the set
       a schema cannot state, and note that nothing downstream catches these
       either — `docker compose config` even accepts an ingress port beside
       endpoint_mode dnsrr, and only the daemon rejects it. */ -}}
{{- $peers := int .Values.cluster.peers -}}
{{- if and .Values.persistence.enabled .Values.persistence.volumePaths -}}
{{- if ne (len .Values.persistence.volumePaths) $peers -}}
{{- fail (printf "persistence.volumePaths has %d entries but cluster.peers is %d. Give exactly one absolute host path per peer, in peer order, or leave it [] to use named volumes." (len .Values.persistence.volumePaths) $peers) -}}
{{- end -}}
{{- end -}}
{{- if and .Values.persistence.enabled (not .Values.persistence.volumePaths) (contains "/" .Values.persistence.volumePrefix) -}}
{{- fail "persistence.volumePrefix is a Docker named-volume name prefix and cannot contain '/'. To store data under host directories, set persistence.volumePaths instead." -}}
{{- end -}}
{{- if and .Values.network.encrypted .Values.network.external -}}
{{- fail "network.encrypted only applies to a chart-managed overlay: an external network's driver options are fixed when it is created, so setting this on external:true would silently not encrypt anything. Either set network.external: false, or pre-create the overlay yourself with `docker network create --opt encrypted`." -}}
{{- end -}}
{{- $singleWriter := eq .Values.proxy.routing "single-writer" -}}
{{- if and $singleWriter (not .Values.proxy.enabled) -}}
{{- fail "proxy.routing: single-writer is a mode of the proxy, so it needs proxy.enabled: true. Without the proxy, clients reach every peer through network.clientAlias and nothing picks a writer." -}}
{{- end -}}
{{- if and .Values.events.failover.enabled (not .Values.events.failover.events) -}}
{{- fail "events.failover.enabled is on but events.failover.events lists no event. Name each recurring event to keep on the writer as \"<schema>.<event>\"; events not listed are never touched." -}}
{{- end -}}
{{- if and .Values.metrics.enabled (eq .Values.metrics.network .Values.network.name) -}}
{{- fail "metrics.network must differ from network.name: the exporters join both, and the point of a separate metrics overlay is that Prometheus never shares one with the peers' SQL and Galera ports." -}}
{{- end -}}
{{- $force := 0 -}}
{{- if .Values.cluster.forceBootstrap -}}
{{- $force = int .Values.cluster.forceBootstrap -}}
{{- if or (lt $force 1) (gt $force $peers) -}}
{{- fail (printf "cluster.forceBootstrap must be a peer number from 1 to %d, or \"\" to leave it off. Got %v." $peers .Values.cluster.forceBootstrap) -}}
{{- end -}}
{{- end -}}
{{- /* Peer identity and addressing — the part that is easy to get wrong.

       Peers must reach each other at their REAL task addresses: Galera's group
       communication and its state transfers connect to the address a peer
       advertises, and a load-balanced service VIP is not a usable target for
       either. Swarm publishes exactly that under `tasks.<service>`, and a stack's
       service name is `<release>_<service>`, so `tasks.<release>_<peer>` is the
       one name guaranteed to resolve to the peer itself.

       Do NOT reach for `endpoint_mode: dnsrr` to avoid the `tasks.` prefix. It
       looks like the tidier answer — the plain service name then resolves to the
       task — but dnsrr does not register network aliases, so the short per-peer
       alias silently does not exist and only the scoped name resolves. This chart
       shipped that version to CI and every state transfer failed with
       `resolve: Host not found (authoritative)`. VIP mode keeps aliases working,
       which is also what network.clientAlias needs. */ -}}
{{- $prefix := .Chart.Name -}}
{{- $names := list -}}
{{- $addrs := list -}}
{{- range $i := until $peers -}}
{{- $nm := printf "%s-%d" $prefix (add1 $i) -}}
{{- $names = append $names $nm -}}
{{- $addrs = append $addrs (printf "tasks.%s_%s" $.Release.Name $nm) -}}
{{- end -}}
{{- $gcomm := printf "gcomm://%s" (join "," $addrs) -}}
{{- /* Where a peer waiting in an all-down cluster serves its position to the others,
       for the election in the rejoin wait. Inside the overlay only, never published. */ -}}
{{- $electionPort := 4566 -}}
{{- $peerList := join " " $addrs -}}
version: "3.9"

services:
{{- range $i := until $peers }}
{{- $n := add1 $i }}
{{- $name := printf "%s-%d" $prefix $n }}
{{- $others := list }}
{{- range $addrs }}{{ if ne . (printf "tasks.%s_%s" $.Release.Name $name) }}{{ $others = append $others . }}{{ end }}{{ end }}
{{- $others = join " " $others }}

  {{ $name }}:
    image: {{ $.Values.image.repository }}:{{ if $.Values.image.tag }}{{ $.Values.image.tag }}{{ else }}{{ $.Chart.AppVersion }}{{ end }}
    # A stable hostname: Swarm otherwise names the container after the task, which
    # changes on every reschedule and is what shows up in this peer's own error log
    # and in the others' membership messages.
    hostname: {{ $name }}
    # Long enough for mariadbd to finish a clean shutdown: flush the buffer pool and
    # write grastate.dat. Killed partway, a peer is left at seqno -1, as after a crash.
    stop_grace_period: {{ $.Values.stopGracePeriod }}

    networks:
      {{ $.Values.network.name }}:
        aliases:
          # The per-peer alias the other peers dial. Declared explicitly rather
          # than relying on the name Swarm derives from the stack, so the address
          # in wsrep_cluster_address is one this chart controls.
          - {{ $name }}
{{- if and $.Values.network.clientAlias (not $.Values.proxy.enabled) }}
          # Shared by every peer, so a client resolving it gets them all and
          # spreads connections over them. Any peer accepts writes, so no leader
          # election is needed. Swarm stops resolving it to a peer with no healthy
          # task, so a failed peer leaves the endpoint on its own — after the
          # healthcheck's detection window.
          #
          # When proxy.enabled, this alias belongs to the proxy instead: two things
          # answering the same name would defeat the point of putting a
          # health-aware proxy in front.
          - {{ $.Values.network.clientAlias }}
{{- end }}

{{- if and $.Values.exposure.enabled (not $.Values.proxy.enabled) }}
    # host mode only — see the exposure.mode guard at the top of this template.
    # With proxy.enabled the port is published on the proxy instead: exposing the
    # peers too would let external clients bypass its health checks.
    # Galera's own ports (4567/4568/4444) are deliberately NOT published: peers
    # reach each other over the overlay, so replication never touches the host.
    ports:
      - target: {{ $.Values.exposure.port }}
        published: {{ $.Values.exposure.port }}
        protocol: {{ $.Values.exposure.protocol | default "tcp" }}
        mode: host
{{- end }}

{{- if $.Values.persistence.enabled }}
    volumes:
{{- if $.Values.persistence.volumePaths }}
      - {{ index $.Values.persistence.volumePaths $i }}:/var/lib/mysql
{{- else }}
      - {{ printf "%s-%d" $.Values.persistence.volumePrefix $n }}:/var/lib/mysql
{{- end }}
{{- end }}

    secrets:
      - {{ $.Values.auth.rootSecretName }}
{{- if $.Values.auth.appUser.enabled }}
      - {{ $.Values.auth.appUser.secretName }}
{{- end }}

    # Passwords are read from the mounted secret files via the image's MARIADB_*_FILE
    # convention, so the plaintext is never in the compose file or `docker inspect`
    # (which show only the /run/secrets/... path), only inside the container.
    # Every peer carries them because any peer may be the one that bootstraps and
    # runs first-time initialisation; the peers that instead join get their user
    # table from the state transfer, which overwrites whatever they initialised.
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/{{ $.Values.auth.rootSecretName }}
{{- if $.Values.auth.appUser.enabled }}
      MARIADB_DATABASE: {{ $.Values.auth.appUser.database | quote }}
      MARIADB_USER: {{ $.Values.auth.appUser.username | quote }}
      MARIADB_PASSWORD_FILE: /run/secrets/{{ $.Values.auth.appUser.secretName }}
{{- end }}

    # The image's own entrypoint still does all the work; this wrapper only decides
    # ONE thing before handing over — whether this peer joins the others or forms a
    # new cluster. `$$` is the compose escape for a literal `$`, so every expansion
    # below happens inside the container.
    entrypoint:
      - /bin/bash
      - -c
    command:
      - |-
        set -eu
        # PID 1 ignores SIGTERM unless it traps it, so without this a peer still waiting
        # for the cluster would sit out the whole stop_grace_period on every stop. Once
        # mariadbd is exec'd it handles SIGTERM itself.
        trap 'exit 0' TERM INT
        # The state-transfer account. mariadb-backup connects to the DONOR peer to
        # stream its data dir; authenticating VIA unix_socket matches the account
        # against the OS user mysqld already runs as, so there is no password to
        # put on a command line, in a config file or in a log. Only a peer that
        # initialises its own data dir ever runs this file.
        mkdir -p /docker-entrypoint-initdb.d
        printf '%s\n' \
          "CREATE USER IF NOT EXISTS 'mysql'@'localhost' IDENTIFIED VIA unix_socket;" \
          "GRANT RELOAD, PROCESS, LOCK TABLES, REPLICATION CLIENT ON *.* TO 'mysql'@'localhost';" \
          > /docker-entrypoint-initdb.d/00-galera-sst-user.sql
        # A state transfer records its PID in /var/lib/mysql/wsrep_sst.pid and the
        # SST script refuses to start a new one while that PID is alive. It tests
        # liveness with `ps -p`, and a container's PIDs restart from 1 — so a file
        # left behind by a transfer that was interrupted names a PID that almost
        # always matches some live process in the NEW container (PID 1 is this
        # very shell). The script then waits 30s for "the previous SST" and exits
        # 114, on every restart, forever: one interrupted transfer wedges the peer
        # permanently. At container start nothing of ours can be running, which is
        # exactly what makes the file meaningless and safe to drop.
        rm -f /var/lib/mysql/wsrep_sst.pid
        # This peer's own overlay address, taken from /etc/hosts — where Docker
        # writes the container's hostname — and never from DNS.
        #
        # Galera has to BIND its IST listener to whatever this says, so it must be
        # a real local address. A `tasks.<release>_<peer>` name does not resolve
        # inside the container, and handing one to Galera produces
        # `Failed to open IST listener ... resolve: Host not found (authoritative)`,
        # after which the joiner aborts and every state transfer to it fails. A
        # name is therefore never safe here, however convenient it looks.
        #
        # There is deliberately NO fallback: a peer that cannot establish its own
        # address must refuse to start, because the alternative is joining while
        # advertising something no other peer can dial — which fails later, looks
        # like a replication bug, and is far harder to read than this line.
        SELF_ADDR="$$(awk -v h="$$(hostname)" '$$1 !~ /^127\./ { for (i = 2; i <= NF; i++) if ($$i == h) { print $$1; exit } }' /etc/hosts)"
        if [ -z "$$SELF_ADDR" ]; then
          echo 'mariadb-galera: cannot determine this peer own address from /etc/hosts' >&2
          exit 1
        fi
        # Printed first by every peer of this chart, so a log without it is an older one.
        echo "mariadb-galera: peer {{ $n }} of {{ $peers }} starting at $$SELF_ADDR"
        GCOMM='{{ $gcomm }}'
{{- if eq $force $n }}
        # cluster.forceBootstrap names this peer, so form a NEW cluster and skip
        # every check below. Clear the value once the cluster is healthy.
        #
        # Galera refuses to form a cluster from a node whose grastate.dat says
        # safe_to_bootstrap: 0, and after peers stop together, which is what an upgrade
        # that changes every peer does, that is every one of them. Naming a peer here is
        # the operator taking that decision, so the flag is set for them.
        if [ -f /var/lib/mysql/grastate.dat ]; then
          sed -i 's/^safe_to_bootstrap: 0$$/safe_to_bootstrap: 1/' /var/lib/mysql/grastate.dat
        fi
        GCOMM='gcomm://'
{{- else }}
        # REJOINING PEER: start mariadbd only once a MEMBER answers on the Galera port: a
        # peer running inside a cluster. A mariadbd started with no member to reach dies
        # with `No address to connect`, rewriting grastate.dat to seqno -1 each time. So
        # wait, without a limit. Swarm publishes a task in DNS only once its healthcheck
        # passes, and a peer passes it only inside a cluster or while it elects (below).
        #
        # While no member is up, the peers ELECT one to form the cluster, and that is
        # also how a first install starts. Each serves its position on port {{ $electionPort }}:
        # its seqno, from grastate.dat or from --wsrep-recover after a crash, or -2 when
        # its data dir is empty. Once every one of the {{ $peers }} peers has reported, the highest
        # seqno wins, then the lowest peer number, so each peer computes the same winner:
        #   * a peer with data beats every empty one, so an empty or rebuilt peer can
        #     never form a cluster that the others then copy;
        #   * when every peer is empty, as on a first install, peer 1 forms a new one;
        #   * fewer than all never elect: a missing peer may hold the newest data, and
        #     cluster.forceBootstrap is the way out then. So it is for a crashed peer
        #     whose position --wsrep-recover cannot read.
        # The peer Galera marked safe_to_bootstrap: 1, the last to leave a cluster that
        # stopped one peer at a time, forms it again without waiting for the others.
        # Neither depends on cluster.forceBootstrap, so setting or clearing that value
        # changes only the forced peer.
        if [ -f /var/lib/mysql/.galera-elected ]; then ELECTED=yes; else ELECTED=no; fi
        rm -f /tmp/galera-electing
        NOTED=-60
        ELECTING=no
        READ=no
        SEQNO=''
        SOCAT=''
        while :; do
          STATES=''
          MEMBER=''
          for p in {{ $others }}; do
            getent hosts "$$p" >/dev/null || continue
            if timeout 2 bash -c "exec 3<>/dev/tcp/$$p/4567" 2>/dev/null; then
              MEMBER="$$p"
              MEMBER_ADDR="$$(getent hosts "$$p" | awk '{print $$1; exit}')"
              break
            fi
            if S="$$(timeout 3 bash -c "exec 3<>/dev/tcp/$$p/{{ $electionPort }} && head -n1 <&3" 2>/dev/null)" && [ -n "$$S" ]; then
              STATES="$$STATES$$S;"
            fi
          done
          if [ -n "$$MEMBER" ]; then
            rm -f /var/lib/mysql/.galera-elected
            if [ "$$ELECTING" = yes ]; then
              # This container reported healthy while it elected; a fresh one gets the
              # healthcheck's full start period for its state transfer.
              echo "mariadb-galera: $$MEMBER ($$MEMBER_ADDR) is up, so this peer restarts to join it"
              exit 0
            fi
            echo "mariadb-galera: $$MEMBER ($$MEMBER_ADDR) is up, so this peer joins it"
            break
          fi
          if grep -qx 'safe_to_bootstrap: 1' /var/lib/mysql/grastate.dat 2>/dev/null; then
            echo 'mariadb-galera: no peer is up and this one left the cluster last (safe_to_bootstrap: 1), so it forms it again'
            rm -f /var/lib/mysql/.galera-elected
            GCOMM='gcomm://'
            break
          fi
          if [ "$$READ" = no ]; then
            READ=yes
            if [ ! -d /var/lib/mysql/mysql ]; then
              SEQNO=-2
            else
              SEQNO="$$(sed -n 's/^seqno:[[:space:]]*//p' /var/lib/mysql/grastate.dat 2>/dev/null || true)"
              if [ -z "$$SEQNO" ] || [ "$$SEQNO" = -1 ]; then
                # 12.3.3 and later refuse to start, even only to recover, without a
                # cluster address; this process never connects to anyone.
                POS="$$(gosu mysql mariadbd --wsrep-on=ON --wsrep-provider=/usr/lib/galera/libgalera_smm.so \
                  --wsrep-cluster-address=gcomm:// --wsrep-recover 2>&1 \
                  | sed -n 's/.*WSREP: Recovered position: \([0-9a-f-]*:[-0-9]*\).*/\1/p' | sed -n '$$p')"
                # A data dir that was never part of a cluster, one killed during its first
                # initialisation or its first state transfer, has no history: it is as
                # empty as no data dir at all, and would otherwise never report.
                case "$$POS" in
                  00000000-0000-0000-0000-000000000000:*) SEQNO=-2 ;;
                  *) SEQNO="$${POS##*:}" ;;
                esac
              fi
              [ "$$SEQNO" != -1 ] || SEQNO=''
            fi
          fi
          # A peer that already won does not report again: a healthy report would end
          # its new container's start period before it has even begun to bootstrap.
          if [ "$$ELECTED" = no ] && [ "$$ELECTING" = no ] && [ -n "$$SEQNO" ]; then
            printf '%s %s\n' {{ $n }} "$$SEQNO" > /tmp/galera-position
            socat TCP-LISTEN:{{ $electionPort }},fork,reuseaddr SYSTEM:'cat /tmp/galera-position' 2>/dev/null &
            SOCAT=$$!
            touch /tmp/galera-electing
            ELECTING=yes
            echo "mariadb-galera: no peer is up, so the peers elect one to form the cluster (this one is at seqno $$SEQNO)"
          fi
          if [ -n "$$SEQNO" ] && [ "$$(printf '%s' "$$STATES" | tr ';' '\n' | grep -c .)" -eq {{ sub $peers 1 }} ]; then
            WINNER="$$(printf '%s%s %s' "$$STATES" {{ $n }} "$$SEQNO" | tr ';' '\n' | sort -k2,2nr -k1,1n | sed -n '1s/ .*//p')"
            if [ "$$WINNER" != {{ $n }} ] && [ "$$ELECTED" = yes ]; then
              # A marker left by an earlier round that this peer no longer wins: report
              # again, or the others would wait for it forever.
              rm -f /var/lib/mysql/.galera-elected
              ELECTED=no
            fi
            if [ "$$WINNER" = {{ $n }} ]; then
{{- if $.Values.persistence.enabled }}
              if [ "$$ELECTED" = yes ]; then
                echo "mariadb-galera: the peers elected this one at seqno $$SEQNO and none is up, so it forms the cluster"
                rm -f /var/lib/mysql/.galera-elected
                if [ -f /var/lib/mysql/grastate.dat ]; then
                  sed -i 's/^safe_to_bootstrap: 0$$/safe_to_bootstrap: 1/' /var/lib/mysql/grastate.dat
                fi
                GCOMM='gcomm://'
                break
              fi
              # The marker on the volume survives the restart, which gives the container
              # that bootstraps the healthcheck's full start period.
              echo "mariadb-galera: elected to form the cluster at seqno $$SEQNO; restarting to do it"
              touch /var/lib/mysql/.galera-elected
              exit 0
{{- else }}
              # Without a volume a marker would not survive a restart, and the data dir
              # is empty, so this peer initialises and bootstraps in place.
              echo "mariadb-galera: the peers elected this one at seqno $$SEQNO and none is up, so it forms the cluster"
              rm -f /tmp/galera-electing
              [ -z "$$SOCAT" ] || kill "$$SOCAT" 2>/dev/null || true
              GCOMM='gcomm://'
              break
{{- end }}
            fi
          fi
          if [ $$((SECONDS - NOTED)) -ge 60 ]; then
            echo 'mariadb-galera: waiting for a peer to come up. If every peer is down, see README.md, Recovering a fully stopped cluster.'
            NOTED=$$SECONDS
          fi
          sleep 2
        done
{{- end }}
{{- if $.Values.proxy.enabled }}
        # Synced responder for the proxy. socat, gosu and the mariadb client are
        # all already in this image, so this needs no extra package and no sidecar.
        # It answers 200 only at wsrep_local_state=4 (Synced) — which is exactly
        # the state the CONTAINER healthcheck deliberately does NOT require, so a
        # peer donating a state transfer stops receiving client traffic without
        # Swarm killing it. The query runs as the mysql unix user, reusing the same
        # unix_socket account as the state transfers.
        cat > /usr/local/bin/galera-synced-check <<'CHECK'
        #!/bin/bash
        s=$$(gosu mysql mariadb -N -B -e "SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME='WSREP_LOCAL_STATE'" 2>/dev/null)
        if [ "$$s" = "4" ]; then
          printf 'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 7\r\nConnection: close\r\n\r\nSynced\n'
        else
          printf 'HTTP/1.1 503 Service Unavailable\r\nContent-Type: text/plain\r\nContent-Length: 11\r\nConnection: close\r\n\r\nNot Synced\n'
        fi
        CHECK
        chmod +x /usr/local/bin/galera-synced-check
        # stderr is dropped on purpose: HAProxy closes each check connection as soon
        # as it has the response, so socat logs "Connection reset by peer" once per
        # check — at inter 2s that is ~30 lines a minute per peer, drowning the
        # database's own log. The responder's health is visible where it matters,
        # in HAProxy's backend state.
        socat TCP-LISTEN:{{ $.Values.proxy.checkPort }},fork,reuseaddr EXEC:/usr/local/bin/galera-synced-check 2>/dev/null &
{{- end }}
        # --server-id is the peer's own number. At start-up a Galera peer disables every
        # scheduled event whose originator is not its server_id, which is what keeps a
        # peer rebuilt by a state transfer from running the events it copied from its
        # donor. With one server_id on every peer, both would run them.
        exec docker-entrypoint.sh mariadbd \
          --wsrep-on=ON \
          --wsrep-provider=/usr/lib/galera/libgalera_smm.so \
          --wsrep-cluster-name={{ $.Values.cluster.name | quote }} \
          --wsrep-cluster-address="$$GCOMM" \
          --wsrep-node-name={{ $name }} \
          --wsrep-node-address="$$SELF_ADDR" \
          --server-id={{ $n }} \
          --wsrep-sst-method=mariabackup \
          --wsrep-sst-auth=mysql: \
          --binlog-format=ROW \
          --default-storage-engine=InnoDB \
          --innodb-autoinc-lock-mode=2{{ range $.Values.extraArgs }} \
          {{ . | quote }}{{ end }}

{{- if $.Values.healthcheck.enabled }}
    # --galera_ready requires WSREP_READY=ON: connected to a primary component and
    # able to serve. Deliberately NOT --galera_online (wsrep_local_state == 4,
    # Synced), which looks stricter and better and is a trap: a peer DONATING a
    # state transfer sits in state 2 (Donor/Desynced) for the whole transfer while
    # remaining perfectly writable — mariabackup is specifically the method that
    # lets a donor keep serving. Under the strict check that donor is "unhealthy",
    # and once a transfer runs longer than interval x retries Swarm KILLS it,
    # aborting the transfer during exactly the operation the cluster needs most.
    #
    # What --galera_ready still catches is everything that should leave the client
    # endpoint: a joiner receiving a transfer, a peer that lost the primary
    # component, and a dead one. The cost is that a donor's apply queue lags, so it
    # can serve slightly stale reads mid-transfer; clients needing causal reads set
    # wsrep_sync_wait, which is what ci/e2e-check.sh demonstrates.
    #
    # See healthcheck.startPeriod in values.yaml for why that window must still
    # cover a full state transfer on the RECEIVING side.
    #
    # --su-mysql is load-bearing and must stay FIRST (the script re-execs itself
    # through gosu, discarding earlier options). Without it the check authenticates
    # from $DATADIR/.my-healthcheck.cnf, which the entrypoint writes during local
    # initialisation — and a state transfer REPLACES the data dir, taking that file
    # with it. The check then falls back to root with no password and fails forever
    # on a peer that is perfectly healthy: `Access denied for user 'root'@'localhost'
    # (using password: NO)` every interval, until Swarm kills the task. Running as
    # the mysql unix user instead authenticates through the same unix_socket account
    # this chart creates for state transfers, so it needs no password and no file in
    # the data dir.
    #
    # One exception: a peer electing in an all-down cluster (see REJOINING PEER above)
    # reports healthy without running mariadbd, so that Swarm publishes it in DNS and
    # the others can count it. The marker exists only while no member is up, so no
    # running cluster ever waits on such a peer. An upgrade during a full stop does: the
    # peer it updates elects, then restarts. CMD-SHELL runs dash, which is enough for
    # `test`; exec keeps --su-mysql first.
    healthcheck:
      test:
        - CMD-SHELL
        - test -e /tmp/galera-electing || exec healthcheck.sh --su-mysql --connect --galera_ready
      interval: {{ $.Values.healthcheck.interval }}
      timeout: {{ $.Values.healthcheck.timeout }}
      retries: {{ $.Values.healthcheck.retries }}
      start_period: {{ $.Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      # One replica per peer, always: a peer IS a service here, and two tasks
      # sharing one data dir would corrupt it. Scale the cluster with
      # cluster.peers, never with replicas.
      replicas: 1
      # vip (the default, stated explicitly because it is load-bearing): it is what
      # keeps network aliases working, which both the per-peer alias and
      # network.clientAlias depend on. Peers address each other by
      # `tasks.<release>_<peer>` instead, which resolves to the task itself — see
      # the addressing note at the top of this template.
      endpoint_mode: vip
{{- if $.Values.healthcheck.enabled }}
      {{- /* Swarm watches a task for `monitor` after CREATING it, and only counts a
             failure inside that window against the rollout. Shorter than the
             healthcheck needs to fail and a broken deploy reports success. */}}
      update_config:
        monitor: {{ $.Values.healthcheck.monitor }}
        # The old task must be gone before the new one starts: both would otherwise
        # mount the same data dir.
        order: stop-first
{{- else }}
      update_config:
        order: stop-first
{{- end }}
{{- /* Each peer is pinned to the node holding ITS volume, so the pins differ per
       peer — unlike the single-service stateful charts. The pin travels with
       persistence: it exists only while a volume needs pinning, so the documented
       ephemeral mode never strands a task Pending on a missing node label.
       placement.constraints adds extras and applies in every mode. */}}
{{- $constraints := list }}
{{- if and $.Values.persistence.enabled $.Values.persistence.nodeLabelPrefix }}
{{-   $constraints = append $constraints (printf "node.labels.%s-%d == true" $.Values.persistence.nodeLabelPrefix $n) }}
{{- end }}
{{- range $.Values.placement.constraints }}
{{-   $constraints = append $constraints . }}
{{- end }}
{{- if $constraints }}
      placement:
        constraints:
{{- range $constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- with $.Values.resources.limits.memory }}
      resources:
        limits:
          memory: {{ . | quote }}
{{- end }}
      restart_policy:
        condition: any
      # swarmcli >= 2.2.0 updates services carrying this label one at a time, each
      # converged before the next, so an upgrade never stops every peer together.
      labels:
        - "com.swarmcli.rollout=sequential"
{{- range $key, $val := $.Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- if $.Values.metrics.enabled }}

  {{ $prefix }}-exporter-{{ $n }}:
    image: {{ $.Values.metrics.image.repository }}:{{ $.Values.metrics.image.tag }}

    # The Galera overlay to reach this peer, and the metrics overlay for Prometheus to
    # reach the exporter. The peer itself never joins the metrics overlay, so nothing
    # there can reach its SQL or Galera ports.
    networks:
      - {{ $.Values.network.name }}
      - {{ $.Values.metrics.network }}

    secrets:
      - {{ $.Values.metrics.secretName }}

    # The exporter takes its password only from MYSQLD_EXPORTER_PASSWORD, so it is
    # read from the mounted secret at start and never lands in the compose file or
    # `docker inspect`. `$$` is the compose escape for a literal `$`.
    #
    # tasks.<release>_<peer> resolves to this peer's task, and to nothing while it
    # has none, so a missing peer reads as mysql_up 0 at once rather than a connect
    # timeout against an empty VIP.
    entrypoint:
      - /bin/sh
      - -c
    command:
      - >-
        export MYSQLD_EXPORTER_PASSWORD="$$(cat /run/secrets/{{ $.Values.metrics.secretName }})";
        exec /bin/mysqld_exporter
        --mysqld.address=tasks.{{ $.Release.Name }}_{{ $name }}:3306
        --mysqld.username={{ $.Values.metrics.username }}

    deploy:
      replicas: 1
{{- /* The same pin as the peer it watches: Prometheus labels every target with the
       node it runs on, and that should be the peer's node. */}}
{{- if $constraints }}
      placement:
        constraints:
{{- range $constraints }}
          - {{ . }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
      # Only the discovery labels, never $.Values.labels: once a service opts in,
      # every one of its deploy labels is readable through Prometheus's targets API.
      labels:
        - "prometheus.io/scrape=true"
        - "prometheus.io/port=9104"
{{- end }}
{{- end }}

{{- if .Values.metrics.enabled }}

  # Creates the exporters' database user, or resets its password, then exits. It
  # logs in as root over the overlay rather than running inside a peer, so turning
  # metrics on works on a cluster that already exists without restarting any peer.
  # Galera replicates the statements, so one peer that takes them is enough; a peer
  # still joining refuses them, and the loop moves on to the next.
  #
  # Swarm runs it again only when its spec changes, which is what a rotation does:
  # a new metrics.secretName.
  {{ $prefix }}-exporter-user:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

    networks:
      - {{ .Values.network.name }}

    secrets:
      - {{ .Values.auth.rootSecretName }}
      - {{ .Values.metrics.secretName }}

    # MYSQL_PWD keeps the root password off the command line. The exporter password
    # has to travel inside the statement, so it is escaped as a SQL string literal
    # the way the image's own entrypoint escapes the passwords it sets, and the
    # statements go in on stdin: `-e` would put them, password included, in this
    # process's argv for anyone on the node to read. sql_log_off keeps them out of a
    # general query log the operator may have enabled.
    entrypoint:
      - /bin/bash
      - -c
    command:
      - |-
        set -eu
        export MYSQL_PWD="$$(cat /run/secrets/{{ .Values.auth.rootSecretName }})"
        pw="$$(cat /run/secrets/{{ .Values.metrics.secretName }})"
        nl=$$'\n'
        pw="$${pw//\\/\\\\}"
        pw="$${pw//$$nl/\\n}"
        pw="$${pw//\'/\\\'}"
        user="'{{ .Values.metrics.username }}'@'%'"
        sql="SET SESSION sql_log_off = 1;
        CREATE USER IF NOT EXISTS $$user IDENTIFIED BY '$$pw' WITH MAX_USER_CONNECTIONS 3;
        ALTER USER $$user IDENTIFIED BY '$$pw' WITH MAX_USER_CONNECTIONS 3;
        GRANT PROCESS, REPLICATION CLIENT, SLAVE MONITOR ON *.* TO $$user;"
        for _ in $$(seq 1 60); do
          for p in {{ $peerList }}; do
            if err="$$(mariadb -h "$$p" -uroot 2>&1 <<<"$$sql")"; then
              echo "mariadb-galera: exporter user {{ .Values.metrics.username }} is ready (via $$p)"
              exit 0
            fi
          done
          sleep 5
        done
        echo "mariadb-galera: no peer accepted the exporter user statements; last error: $$err" >&2
        exit 1

    deploy:
      replicas: 1
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
      # on-failure, not none: a first install can take longer than the loop above to
      # become writable, and Swarm then simply runs it again.
      restart_policy:
        condition: on-failure
{{- end }}

{{- if .Values.events.failover.enabled }}

  # Scheduled-event failover (README.md § Event failover). Every 5s it finds the writer,
  # the lowest-numbered Synced peer, which is the rule proxy.routing: single-writer
  # routes by, and makes it the one peer that runs each listed event: first off on
  # every other peer it can reach, locally, then on on the writer, which Galera
  # replicates as off everywhere else. Each ALTER names the event's own definer and
  # character set, which a bare ALTER EVENT replaces with root and the session's.
  # Events not listed are never touched: a peer holds an event someone disabled on
  # purpose exactly as it holds one another peer runs, so nothing can tell them apart.
  #
  # It logs in as root over the overlay, like the exporter-user one-shot, because
  # ALTER DEFINER needs SET USER. One replica, replaced stop-first, so that two never
  # race each other's ALTERs.
  {{ $prefix }}-events:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

    networks:
      - {{ .Values.network.name }}

    secrets:
      - {{ .Values.auth.rootSecretName }}

    entrypoint:
      - /bin/bash
      - -c
    command:
      - |-
        set -u
        PEERS=({{ $peerList }})
        EVENTS='{{ join " " .Values.events.failover.events }}'
        MYSQL_PWD="$$(cat /run/secrets/{{ .Values.auth.rootSecretName }})"
        export MYSQL_PWD
        log() { echo "mariadb-galera-events: $$*"; }
        # Logs a condition once, and again only once it has changed.
        declare -A noted
        note() { [ "$${noted[$$1]:-}" = "$$2" ] || { [ -z "$$2" ] || log "$$2"; noted[$$1]="$$2"; }; }
        sql() { mariadb -h "$$1" -uroot -N -B --connect-timeout=2 <<<"$$2"; }
        # A SQL string literal, escaped the way the image's entrypoint escapes passwords.
        lit() { local s="$$1"; s="$${s//\\/\\\\}"; s="$${s//\'/\\\'}"; printf "'%s'" "$$s"; }
{{- if .Values.metrics.enabled }}
        cat > /usr/local/bin/events-metrics <<'SERVE'
        #!/bin/bash
        while IFS= read -r -t 2 l && [ -n "$${l%$$'\r'}" ]; do :; done
        body="$$(cat /tmp/events.prom 2>/dev/null)"
        printf 'HTTP/1.1 200 OK\r\nContent-Type: text/plain; version=0.0.4\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s\n' "$$(($${#body} + 1))" "$$body"
        SERVE
        chmod +x /usr/local/bin/events-metrics
        socat TCP-LISTEN:9104,fork,reuseaddr EXEC:/usr/local/bin/events-metrics 2>/dev/null &
{{- end }}

        prev=0
        declare -A last
        takeovers=0 errors=0 missed=0
        while :; do
          synced=()
          writer=0
          for i in "$${!PEERS[@]}"; do
            s="$$(sql "$${PEERS[i]}" "SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME = 'WSREP_LOCAL_STATE'" 2>/dev/null || true)"
            if [ "$$s" = 4 ]; then
              synced+=("$$((i + 1))")
              [ "$$writer" != 0 ] || writer=$$((i + 1))
            fi
          done
          if [ "$$writer" != "$$prev" ]; then
            if [ "$$writer" = 0 ]; then log 'no peer is Synced, so no peer runs the listed events'
            elif [ "$$prev" = 0 ]; then log "peer $$writer is the writer"
            else log "peer $$writer is the writer, was peer $$prev"; fi
          fi
          misplaced=0
          scheduler_off=0
          if [ "$$writer" != 0 ]; then
            w="$${PEERS[writer - 1]}"
            # A run due while the writer changed was skipped: MariaDB never makes one up.
            if [ "$$prev" != 0 ] && [ "$$prev" != "$$writer" ]; then
              for e in $$EVENTS; do
                [ -n "$${last[$$e]:-}" ] || continue
                IFS=$$'\x1f' read -r at value unit tz <<<"$${last[$$e]}"
                [[ $$unit =~ ^[A-Z_]+$$ ]] || continue
                # Fresher from the old writer itself while it still answers, as at a failback:
                # the last check's value may be a run behind.
                fresh="$$(sql "$${PEERS[prev - 1]}" "SELECT IFNULL(LAST_EXECUTED, '') FROM information_schema.EVENTS WHERE EVENT_SCHEMA = $$(lit "$${e%%.*}") AND EVENT_NAME = $$(lit "$${e#*.}")" 2>/dev/null || true)"
                [ -z "$$fresh" ] || at="$$fresh"
                next="TIMESTAMP($$(lit "$$at")) + INTERVAL $$(lit "$${value//\'/}") $$unit"
                due="$$(sql "$$w" "SELECT IF($$next <= CONVERT_TZ(UTC_TIMESTAMP(), '+00:00', $$(lit "$$tz")), $$next, '')" 2>/dev/null || true)"
                if [ -n "$$due" ]; then
                  missed=$$((missed + 1))
                  log "$$e was due at $$due ($$tz) while the writer changed from peer $$prev to peer $$writer, and may not have run, or not to the end. MariaDB does not make up a missed run: check, and run it by hand if it is needed"
                fi
              done
            fi
            if [ "$$(sql "$$w" 'SELECT @@event_scheduler' 2>/dev/null)" != ON ]; then
              scheduler_off=1
              note scheduler "event_scheduler is not ON on peer $$writer, so the listed events do not run at all: add --event-scheduler=ON to extraArgs"
            else
              note scheduler ''
            fi
            for e in $$EVENTS; do
              schema="$${e%%.*}" name="$${e#*.}"
              where="EVENT_SCHEMA = $$(lit "$$schema") AND EVENT_NAME = $$(lit "$$name")"
              # One field separator that no value contains: read with a whitespace IFS, an empty
              # field would shift every field after it.
              row="$$(sql "$$w" "SELECT CONCAT_WS(CHAR(31), EVENT_TYPE, STATUS, DEFINER, CHARACTER_SET_CLIENT, COLLATION_CONNECTION, ORIGINATOR, IFNULL(LAST_EXECUTED, ''), IFNULL(INTERVAL_VALUE, ''), IFNULL(INTERVAL_FIELD, ''), TIME_ZONE) FROM information_schema.EVENTS WHERE $$where" 2>/dev/null || true)"
              if [ -z "$$row" ]; then
                misplaced=$$((misplaced + 1)); note "$$e" "$$e does not exist on peer $$writer, the writer; nothing runs it there"; continue
              fi
              IFS=$$'\x1f' read -r type status definer cs cc originator at value unit tz <<<"$$row"
              if [ "$$type" != RECURRING ]; then
                misplaced=$$((misplaced + 1)); note "$$e" "$$e is a one-time event, which would run again on another peer, so it is left where it is"; continue
              fi
              note "$$e" ''
              as="SET SESSION character_set_client = $$cs, collation_connection = $$cc; ALTER DEFINER = $$(lit "$${definer%@*}")@$$(lit "$${definer##*@}") EVENT \`$$schema\`.\`$$name\`"
              # Off on every other peer first, so that no two peers run it at once. Locally
              # (wsrep_on off), which also reaches a peer outside the primary component, and
              # a donor, which still runs its events while it is not Synced.
              enabled=0
              for i in "$${!PEERS[@]}"; do
                [ "$$(sql "$${PEERS[i]}" "SELECT STATUS FROM information_schema.EVENTS WHERE $$where" 2>/dev/null)" = ENABLED ] || continue
                [[ " $${synced[*]} " != *" $$((i + 1)) "* ]] || enabled=$$((enabled + 1))
                [ "$$((i + 1))" != "$$writer" ] || continue
                if out="$$(sql "$${PEERS[i]}" "SET SESSION wsrep_on = OFF; $$as DISABLE ON SLAVE" 2>&1)"; then
                  log "$$e: turned off on peer $$((i + 1)), to turn it on on the writer, peer $$writer"
                else
                  errors=$$((errors + 1)); log "$$e: could not turn it off on peer $$((i + 1)): $$out"
                fi
              done
              [ "$$enabled" = 1 ] && [ "$$status" = ENABLED ] || misplaced=$$((misplaced + 1))
              if [ "$$status" != ENABLED ]; then
                # Replicated: every other peer then holds it SLAVESIDE_DISABLED.
                if out="$$(sql "$$w" "$$as ENABLE" 2>&1)"; then
                  takeovers=$$((takeovers + 1)); log "$$e: now runs on peer $$writer (it ran on the peer with server_id $$originator)"
                else
                  errors=$$((errors + 1)); log "$$e: could not turn it on on peer $$writer: $$out"
                fi
              fi
              if [ -n "$$at" ]; then last[$$e]="$$at"$$'\x1f'"$$value"$$'\x1f'"$$unit"$$'\x1f'"$$tz"; fi
            done
          fi
          prev="$$writer"
{{- if .Values.metrics.enabled }}
          {
            echo '# HELP mariadb_galera_events_writer_peer The peer the listed events run on, the lowest-numbered Synced peer; 0 when none is.'
            echo '# TYPE mariadb_galera_events_writer_peer gauge'
            echo "mariadb_galera_events_writer_peer $$writer"
            echo '# HELP mariadb_galera_events_misplaced Listed events not running on the writer alone at the last check.'
            echo '# TYPE mariadb_galera_events_misplaced gauge'
            echo "mariadb_galera_events_misplaced $$misplaced"
            echo '# HELP mariadb_galera_events_scheduler_off 1 while event_scheduler is not ON on the writer.'
            echo '# TYPE mariadb_galera_events_scheduler_off gauge'
            echo "mariadb_galera_events_scheduler_off $$scheduler_off"
            echo '# HELP mariadb_galera_events_takeovers_total Listed events turned on on a new writer.'
            echo '# TYPE mariadb_galera_events_takeovers_total counter'
            echo "mariadb_galera_events_takeovers_total $$takeovers"
            echo '# HELP mariadb_galera_events_errors_total Failed attempts to turn a listed event off or on.'
            echo '# TYPE mariadb_galera_events_errors_total counter'
            echo "mariadb_galera_events_errors_total $$errors"
            echo '# HELP mariadb_galera_events_missed_runs_total Runs that fell due while the writer changed and may not have run.'
            echo '# TYPE mariadb_galera_events_missed_runs_total counter'
            echo "mariadb_galera_events_missed_runs_total $$missed"
          } > /tmp/events.prom.new && mv /tmp/events.prom.new /tmp/events.prom
{{- end }}
          sleep 5
        done

    deploy:
      replicas: 1
      update_config:
        order: stop-first
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
{{- if .Values.metrics.enabled }}

  # The controller's metrics, relayed onto the metrics overlay. The controller holds
  # the root password, so like the exporter-user one-shot it stays off that overlay;
  # this relay holds no secret, carries the discovery labels, and forwards each scrape
  # to the controller over the Galera overlay.
  {{ $prefix }}-events-metrics:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

    networks:
      - {{ .Values.network.name }}
      - {{ .Values.metrics.network }}

    entrypoint:
      - socat
    command:
      - TCP-LISTEN:9104,fork,reuseaddr
      - TCP:tasks.{{ .Release.Name }}_{{ $prefix }}-events:9104

    deploy:
      replicas: 1
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
      labels:
        - "prometheus.io/scrape=true"
        - "prometheus.io/port=9104"
{{- end }}
{{- end }}

{{- if .Values.proxy.enabled }}

  {{ $prefix }}-proxy:
    image: {{ .Values.proxy.image.repository }}:{{ .Values.proxy.image.tag }}

    networks:
      {{ .Values.network.name }}:
        aliases:
          - {{ $prefix }}-proxy
{{- if .Values.network.clientAlias }}
          # The client endpoint moves here when the proxy is on: one name, backed
          # by health checks that follow Galera's state rather than DNS.
          - {{ .Values.network.clientAlias }}
{{- end }}
{{- if .Values.exposure.enabled }}

    # The one external endpoint when the proxy is on. Ingress, not exposure.mode:
    # the proxy is a single replicated service, so the routing mesh can share the
    # port across its replicas, where host mode would strand a second replica on
    # a node whose port the first already holds.
    ports:
      - target: {{ .Values.exposure.port }}
        published: {{ .Values.exposure.port }}
        protocol: {{ .Values.exposure.protocol | default "tcp" }}
        mode: ingress
{{- end }}

    # The config travels in an env var and is written out at every start, the same
    # way charts/gitlab-runner carries its config.toml — so a values change takes
    # effect on redeploy and a hand-edit inside the container never survives one.
    # `$$` is the compose escape for a literal `$`.
    entrypoint:
      - /bin/sh
      - -c
    command:
      - >-
        set -eu;
        printf '%s\n' "$$HAPROXY_CFG" > /tmp/haproxy.cfg;
{{- if $singleWriter }}
        printf '%s\n' "$$HAPROXY_LUA" > /tmp/single-writer.lua;
{{- end }}
        exec haproxy -f /tmp/haproxy.cfg -db
    environment:
      HAPROXY_CFG: |
        global
          log stdout format raw local0
          maxconn 4096
{{- if $singleWriter }}
          tune.lua.bool-sample-conversion normal
          lua-load /tmp/single-writer.lua
{{- end }}
        # Docker's embedded DNS, asked again while the proxy runs. Without this,
        # HAProxy looks each peer up once at start, keeps that address for its whole
        # life, and refuses to start while any peer is not yet in DNS. In CI a replica
        # so started routed nothing for minutes while every peer was Synced (#229).
        resolvers docker
          nameserver dns 127.0.0.11:53
        defaults
          mode tcp
          log global
          option tcplog
          timeout connect 5s
          # Database sessions are long-lived and idle between statements; a short
          # timeout here would sever them mid-transaction.
          timeout client 1h
          timeout server 1h
          default-server inter 2s fall 3 rise 2 resolvers docker resolve-prefer ipv4
        listen galera
          bind :{{ .Values.exposure.port }}
          # The check is the Synced responder each peer runs, on its own port —
          # NOT a TCP probe of 3306, which would happily route to a peer that is
          # listening but not Synced.
          option httpchk GET /
          http-check expect status 200
{{- if $singleWriter }}
          # Single-writer: each new connection goes to the first server that is up, in
          # the order below, so every replica picks the lowest-numbered Synced peer.
          # on-marked-down closes a lost writer's connections at once; the Lua task
          # closes the ones left on a peer that is no longer the first one up.
          balance first
{{- end }}
          # Each peer at its task address, the name the peers dial each other by,
          # so no service VIP sits between the proxy and the peer it checks.
{{- range $i := until $peers }}
          server {{ printf "%s-%d" $prefix (add1 $i) }} {{ index $addrs $i }}:{{ $.Values.exposure.port }} check port {{ $.Values.proxy.checkPort }}{{ if $singleWriter }} on-marked-down shutdown-sessions{{ end }}
{{- end }}
{{- if $singleWriter }}
      # When the writer changes back to a lower-numbered peer, `balance first` sends new
      # connections there but leaves the old ones where they are, and HAProxy's own
      # on-marked-up shutdown-backup-sessions covers only a return of the first server.
      # So once a second this closes the connections held to any server but the first
      # one up, whichever peer comes back.
      HAPROXY_LUA: |
        core.register_task(function()
          while true do
            local servers = {}
            for _, sv in pairs(core.backends["galera"].servers) do servers[#servers + 1] = sv end
            table.sort(servers, function(a, b) return tonumber(a:get_puid()) < tonumber(b:get_puid()) end)
            local writer
            for _, sv in ipairs(servers) do
              if writer == nil and sv:get_stats().status:sub(1, 2) == "UP" then
                writer = sv
              elseif sv:get_cur_sess() > 0 then
                core.Warning(string.format("single-writer: closing %d connection(s) to %s; the writer is %s",
                  sv:get_cur_sess(), sv:get_name(), writer and writer:get_name() or "none"))
                sv:shut_sess()
              end
            end
            core.msleep(1000)
          end
        end)
{{- end }}

    healthcheck:
      # HAProxy is up iff it is listening; whether any BACKEND is usable is the
      # cluster's health, not the proxy's, and conflating them would take the
      # endpoint down exactly when clients most need to reach the survivors.
      # CMD, not CMD-SHELL: CMD-SHELL runs /bin/sh, which is dash in this image, and
      # /dev/tcp is a bash feature. Under dash the check fails every time, Swarm
      # kills a perfectly good proxy on a loop, and nothing says why.
      test:
        - CMD
        - bash
        - -c
        - "exec 3<>/dev/tcp/127.0.0.1/{{ .Values.exposure.port }}"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

    deploy:
      # Stateless, so this is the one part of the chart that is safe to scale, and
      # it should be: a single proxy in front of an HA cluster is a single point of
      # failure. Swarm load-balances the client alias across these replicas.
      replicas: {{ .Values.proxy.replicas }}
      endpoint_mode: vip
      update_config:
        monitor: 60s
        order: start-first
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- with .Values.proxy.resources.limits.memory }}
      resources:
        limits:
          memory: {{ . | quote }}
{{- end }}
      restart_policy:
        condition: any
{{- if .Values.labels }}
      labels:
{{- range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}
{{- end }}

{{- if and .Values.persistence.enabled (not .Values.persistence.volumePaths) }}

volumes:
{{- range $i := until $peers }}
  {{ printf "%s-%d" $.Values.persistence.volumePrefix (add1 $i) }}: {}
{{- end }}
{{- end }}

secrets:
  {{ .Values.auth.rootSecretName }}:
    external: true
{{- if .Values.auth.appUser.enabled }}
  {{ .Values.auth.appUser.secretName }}:
    external: true
{{- end }}
{{- if .Values.metrics.enabled }}
  {{ .Values.metrics.secretName }}:
    external: true
{{- end }}

networks:
  {{ .Values.network.name }}:
{{- if .Values.network.external }}
    external: true
{{- else }}
    driver: overlay
    attachable: true
{{- if .Values.network.encrypted }}
    # IPsec on the data plane. Replication carries every row written, so without
    # this it crosses the wire between nodes in the clear.
    driver_opts:
      encrypted: "true"
{{- end }}
{{- end }}
{{- if .Values.metrics.enabled }}
  {{ .Values.metrics.network }}:
    external: true
{{- end }}
