          },
          "expr": "elasticsearch_jvm_memory_used_bytes{stack=\"$stack\",area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{stack=\"$stack\",area=\"heap\"}",
          "refId": "A",
          "legendFormat": "{{name}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Data disk used",
      "description": "Share of the data disk in use. By default Elasticsearch allocates no new shard past 90% and blocks writes to every index at 95%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
