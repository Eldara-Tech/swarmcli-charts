    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency",
      "description": "p99 of GetObject and PutObject, and the mean over every request. PutObject's p99 is read from its millisecond histogram; the per-request histogram and PutObject's seconds one have a smallest bucket 5 seconds wide, so only the mean is read from them.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
