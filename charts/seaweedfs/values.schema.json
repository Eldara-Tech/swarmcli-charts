{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "s3": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 55535 },
        "accessKeySecret": { "type": "string", "minLength": 1 },
        "secretKeySecret": { "type": "string", "minLength": 1 }
      }
    },
    "buckets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
      "uniqueItems": true
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string", "pattern": "^$|^https?://" },
        "clientId": { "type": "string" },
        "jwksUri": { "type": "string", "pattern": "^$|^https?://" },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": { "type": "string", "minLength": 1, "pattern": "^[^*?$]+$" },
              "access": { "type": "string", "enum": ["readonly", "readwrite"] },
              "buckets": {
                "type": "array",
                "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
                "uniqueItems": true
              }
            },
            "required": ["group", "access", "buckets"],
            "additionalProperties": false
          }
        }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "properties": {
          "issuer": { "minLength": 1 },
          "clientId": { "minLength": 1 },
          "grants": { "minItems": 1 }
        },
        "required": ["issuer", "clientId", "grants"]
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumeName": { "type": "string", "pattern": "^[^/]+$" },
        "volumePath": { "type": "string" },
        "nodeLabel": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "traefik", "published"] },
        "network": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "tls": { "type": "boolean" }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "certResolver": { "type": "string" },
        "routerName": { "type": "string" },
        "constraintLabel": { "type": "string" },
        "redirectMiddleware": { "type": "string" },
        "entrypoints": {
          "type": "object",
          "properties": {
            "http": { "type": "string" },
            "https": { "type": "string" }
          }
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mode": { "type": "string", "enum": ["ingress", "host"] }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } },
    "healthcheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "timeout": { "type": "string" },
        "retries": { "type": "integer", "minimum": 1 },
        "startPeriod": { "type": "string" },
        "monitor": { "type": "string" }
      }
    },
    "stopGracePeriod": { "type": "string" },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        },
        "reservations": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        }
      }
    },
    "labels": { "type": "object" }
  }
}
