{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "appset": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["static", "git", "git-sync", "dir"] },
        "path": { "type": "string" },
        "interval": { "type": "string", "minLength": 1 },
        "configName": { "type": "string", "minLength": 1 },
        "configVersion": { "type": "string" },
        "repo": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "revision": { "type": "string" }
          }
        },
        "sync": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 }
              },
              "required": ["repository", "tag"]
            },
            "intervalSeconds": { "type": "integer", "minimum": 1 },
            "sshKeySecret": { "type": "string" },
            "knownHostsSecret": { "type": "string" },
            "volumeName": { "type": "string", "minLength": 1 }
          }
        },
        "dirVolumeName": { "type": "string", "minLength": 1 }
      },
      "required": ["mode"]
    },
    "exposure": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["none", "traefik", "published"] },
        "network": { "type": "string", "minLength": 1 }
      },
      "required": ["mode"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "tls": { "type": "boolean" }
      }
    },
    "traefik": {
      "type": "object",
      "properties": {
        "certResolver": { "type": "string" },
        "entrypoints": {
          "type": "object",
          "properties": {
            "http": { "type": "string", "minLength": 1 },
            "https": { "type": "string", "minLength": 1 }
          }
        },
        "constraintLabel": { "type": "string" },
        "redirectMiddleware": { "type": "string" },
        "middlewares": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mode": { "enum": ["ingress", "host"] }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "adminTokenSecret": { "type": "string", "minLength": 1 }
      },
      "required": ["adminTokenSecret"]
    },
    "git": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "tokenSecret": { "type": "string" }
      }
    },
    "registryAuthSecrets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prune": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumes": { "type": "boolean" }
      }
    },
    "controllerId": { "type": "string", "minLength": 1 },
    "log": {
      "type": "object",
      "properties": {
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "format": { "enum": ["text", "json"] }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "volumeName": { "type": "string", "minLength": 1 },
        "volumePath": { "type": "string" },
        "nodeLabel": { "type": "string" }
      },
      "required": ["enabled"]
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "minLength": 1 },
        "timeout": { "type": "string", "minLength": 1 },
        "retries": { "type": "integer", "minimum": 1 },
        "startPeriod": { "type": "string", "minLength": 1 },
        "monitor": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled"]
    },
    "placement": {
      "type": "object",
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        },
        "reservations": {
          "type": "object",
          "properties": { "memory": { "type": "string" } }
        }
      }
    },
    "labels": { "type": "object" },
    "extraHosts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[^\\s:]+:[0-9A-Fa-f.:]+$" }
    }
  },
  "required": ["image", "appset", "exposure", "auth", "persistence"]
}
