      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, sum by (feature_category) (rate(http_requests_total{stack=\"$stack\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{feature_category}}",
          "range": true
