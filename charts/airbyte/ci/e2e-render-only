# Fixtures that render and validate in scripts/test-charts.sh but are skipped by the default
# all-fixtures `make e2e` sweep. One case name per line; scripts/e2e-test.sh still runs them
# when E2E_CASES names them explicitly.

# These point oauth2-proxy at keycloak.example.com, which does not resolve, so the proxy
# fails its OIDC discovery and never converges. Their differences (exposure mode, TLS,
# extra networks, the data pin) are render-time contracts ci/render-check.sh asserts; the
# mock fixture is the one that deploys.
default
extra-network
none
published

# Points at the operator's own proxy, which CI does not have; ci/render-check.sh asserts the
# server joins exposure.network with no Traefik labels.
noauth-proxy

# Publishes a node port; ci/render-check.sh asserts the server, not a proxy, owns it and that
# the login cookies drop Secure over http. The login fixture deploys the same auth wiring.
login-published

# Points at airbyte.example.com over TLS; ci/render-check.sh asserts the setup endpoint stays open
# before setupComplete and the cookies are Secure. The login fixture deploys the same wiring.
login-tls

# Needs a private registry to prove anything at deploy time; ci/render-check.sh asserts the
# secret mount and FAKEK8S_REGISTRY_AUTH_FILE agree.
registry-auth
