    {
      "id": 15,
      "type": "timeseries",
      "title": "Shards",
      "description": "Active primary and unassigned shards. On a single node the replica of every Zammad index stays unassigned, so a steady unassigned count is normal; an unassigned primary turns the cluster red.",
