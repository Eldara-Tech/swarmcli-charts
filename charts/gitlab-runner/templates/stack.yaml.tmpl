{{- /* url is written into config.toml verbatim; with no value the runner loads a config it
       cannot poll and simply logs a failure every check_interval, forever. */}}
{{- if not .Values.gitlab.url -}}
{{- fail "gitlab.url is required: it is the instance the runner polls, written into config.toml as the runner's url." -}}
{{- end -}}
{{- /* The probe reads /metrics, which exists only when the runner is told to listen. */}}
{{- if and .Values.healthcheck.enabled (not .Values.metrics.enabled) -}}
{{- fail "healthcheck.enabled requires metrics.enabled: the probe reads the runner's /metrics endpoint, and with metrics off there is nothing listening for it to pass." -}}
{{- end -}}
{{- /* Host-path persistence bind-mounts a host dir; a named-volume value must not be a path
       (docker compose would otherwise emit a cryptic error). */}}
{{- if and .Values.persistence.enabled (not .Values.persistence.volumePath) (contains "/" .Values.persistence.volumeName) -}}
{{- fail "persistence.volumeName is a Docker named-volume name and cannot contain '/'. To store /etc/gitlab-runner under a host directory, set persistence.volumePath instead." -}}
{{- end -}}
{{- /* Every runner process needs its OWN .runner_system_id: that file lives beside
       config.toml, so replicas sharing one volume all adopt one identity and GitLab can no
       longer tell them apart in the UI or in system_id metric labels. */}}
{{- if and .Values.persistence.enabled (gt (int .Values.replicas) 1) -}}
{{- fail "replicas > 1 needs persistence.enabled: false — these replicas would share one /etc/gitlab-runner volume and so one .runner_system_id, which GitLab reads as a single runner manager. Scale out with persistence off, or deploy one release per runner." -}}
{{- end -}}
{{- if .Values.cache.enabled -}}
{{- if not .Values.cache.s3.server -}}
{{- fail "cache.s3.server is required when cache.enabled is true: it is the host:port of the S3-compatible endpoint (e.g. minio:9000)." -}}
{{- end -}}
{{- if not .Values.cache.s3.bucket -}}
{{- fail "cache.s3.bucket is required when cache.enabled is true." -}}
{{- end -}}
{{- end -}}
version: "3.9"

{{- $runnerName := .Values.gitlab.name | default .Release.Name }}
{{- /* iam authentication reads a role from the instance, so it needs no secrets at all. */}}
{{- $cacheKeys := and .Values.cache.enabled (eq .Values.cache.s3.authenticationType "access-key") }}
{{- $secrets := list .Values.auth.tokenSecret }}
{{- if $cacheKeys }}
{{- $secrets = append $secrets .Values.cache.s3.accessKeySecret }}
{{- $secrets = append $secrets .Values.cache.s3.secretKeySecret }}
{{- end }}

{{- /* ---------------------------------------------------------------------------------------
       The whole config.toml, built here and written by the container at start.

       A chart cannot ship this file: a Swarm config takes its content from a path and can
       carry no rendered value, and Swarm config data is immutable anyway. So it travels as
       one environment variable, the way the gitlab chart passes GITLAB_OMNIBUS_CONFIG.

       The token is NOT interpolated here. It lands as the literal `${RUNNER_TOKEN}`, which
       the runner expands from its own environment when it loads the file — documented for
       `url` and `token` — so the manifest and `docker inspect` only ever show the reference.

       Nothing generated below may contain a literal `$`: this reaches the compose manifest,
       which Docker interpolates before deploying. `$$` is the escape, and the verbatim
       config.extra*Toml blocks are the operator's to escape.

       Order is load-bearing. [runners.cache.s3] is emitted LAST because the container
       appends the two cache credentials to the end of the file, and TOML keys belong to
       whichever table header precedes them.
       --------------------------------------------------------------------------------------- */}}
{{- $toml := list "# Generated by the swarmcli gitlab-runner chart, rewritten on every container start." }}
{{- $toml = append $toml (printf "concurrent = %v" .Values.concurrent) }}
{{- $toml = append $toml (printf "check_interval = %v" .Values.checkInterval) }}
{{- $toml = append $toml (printf "log_level = %q" .Values.logLevel) }}
{{- $toml = append $toml (printf "log_format = %q" .Values.logFormat) }}
{{- $toml = append $toml (printf "shutdown_timeout = %v" .Values.shutdownTimeout) }}
{{- if .Values.metrics.enabled }}
{{- $toml = append $toml (printf "listen_address = %q" (printf "0.0.0.0:%v" .Values.metrics.port)) }}
{{- end }}
{{- with .Values.config.extraGlobalToml }}
{{- $toml = append $toml "# --- config.extraGlobalToml ---" }}
{{- range splitList "\n" (trimSuffix "\n" .) }}
{{- $toml = append $toml . }}
{{- end }}
{{- end }}
{{- $toml = append $toml "" }}
{{- $toml = append $toml "[[runners]]" }}
{{- $toml = append $toml (printf "  name = %q" $runnerName) }}
{{- $toml = append $toml (printf "  url = %q" .Values.gitlab.url) }}
{{- $toml = append $toml "  token = \"$${RUNNER_TOKEN}\"" }}
{{- $toml = append $toml "  executor = \"docker\"" }}
{{- $toml = append $toml (printf "  request_concurrency = %v" .Values.runner.requestConcurrency) }}
{{- if .Values.runner.limit }}
{{- $toml = append $toml (printf "  limit = %v" .Values.runner.limit) }}
{{- end }}
{{- if .Values.runner.outputLimit }}
{{- $toml = append $toml (printf "  output_limit = %v" .Values.runner.outputLimit) }}
{{- end }}
{{- with .Values.runner.environment }}
{{- $toml = append $toml (printf "  environment = %s" (toJson .)) }}
{{- end }}
{{- $toml = append $toml "  [runners.docker]" }}
{{- $toml = append $toml (printf "    image = %q" .Values.docker.image) }}
{{- $toml = append $toml (printf "    pull_policy = %q" .Values.docker.pullPolicy) }}
{{- $toml = append $toml (printf "    privileged = %v" .Values.docker.privileged) }}
{{- /* The runner reaches the engine over the socket this service mounts; jobs only see it
       when mountSocketInJobs asks for it. Two different grants, one path. */}}
{{- $jobVolumes := .Values.docker.volumes }}
{{- if .Values.docker.mountSocketInJobs }}
{{- $jobVolumes = prepend $jobVolumes "/var/run/docker.sock:/var/run/docker.sock" }}
{{- end }}
{{- with $jobVolumes }}
{{- $toml = append $toml (printf "    volumes = %s" (toJson .)) }}
{{- end }}
{{- with .Values.docker.allowedImages }}
{{- $toml = append $toml (printf "    allowed_images = %s" (toJson .)) }}
{{- end }}
{{- with .Values.docker.networkMode }}
{{- $toml = append $toml (printf "    network_mode = %q" .) }}
{{- end }}
{{- with .Values.docker.memory }}
{{- $toml = append $toml (printf "    memory = %q" .) }}
{{- end }}
{{- with .Values.docker.cpus }}
{{- $toml = append $toml (printf "    cpus = %q" .) }}
{{- end }}
{{- with .Values.config.extraDockerToml }}
{{- $toml = append $toml "    # --- config.extraDockerToml ---" }}
{{- range splitList "\n" (trimSuffix "\n" .) }}
{{- $toml = append $toml . }}
{{- end }}
{{- end }}
{{- if .Values.cache.enabled }}
{{- $toml = append $toml "  [runners.cache]" }}
{{- $toml = append $toml "    Type = \"s3\"" }}
{{- $toml = append $toml (printf "    Shared = %v" .Values.cache.shared) }}
{{- with .Values.cache.path }}
{{- $toml = append $toml (printf "    Path = %q" .) }}
{{- end }}
{{- $toml = append $toml "    [runners.cache.s3]" }}
{{- $toml = append $toml (printf "      ServerAddress = %q" .Values.cache.s3.server) }}
{{- $toml = append $toml (printf "      BucketName = %q" .Values.cache.s3.bucket) }}
{{- with .Values.cache.s3.location }}
{{- $toml = append $toml (printf "      BucketLocation = %q" .) }}
{{- end }}
{{- $toml = append $toml (printf "      Insecure = %v" .Values.cache.s3.insecure) }}
{{- /* `auto` writes no key: upstream types PathStyle as a *bool, and nil is what selects
       the runner's own endpoint detection (path-style for MinIO and its kin, virtual-host
       for AWS). Writing `false` forces virtual-host, which a MinIO without wildcard DNS
       cannot serve — and the cache then fails in a job log, not at deploy. */}}
{{- if eq .Values.cache.s3.addressing "path" }}
{{- $toml = append $toml "      PathStyle = true" }}
{{- else if eq .Values.cache.s3.addressing "virtual" }}
{{- $toml = append $toml "      PathStyle = false" }}
{{- end }}
{{- $toml = append $toml (printf "      AuthenticationType = %q" .Values.cache.s3.authenticationType) }}
{{- if $cacheKeys }}
{{- $toml = append $toml "      # AccessKey and SecretKey are appended here by the container, from the mounted secrets." }}
{{- end }}
{{- end }}

services:

  gitlab-runner:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

    # The image's ENTRYPOINT is `dumb-init /entrypoint`, and /entrypoint ends with
    # `exec gitlab-runner "$$@"` — so replacing only the command would run
    # `gitlab-runner sh -c …`. Both are replaced, and dumb-init is kept as PID 1 so the
    # SIGQUIT Swarm sends still reaches the runner as a graceful drain.
    entrypoint:
      - /usr/bin/dumb-init
      - /bin/sh
      - -c
    # `$$` escapes the `$` for compose, so every expansion below happens inside the
    # container and no secret is resolved into the manifest.
    command:
      - >-
        set -eu;
        test -s /run/secrets/{{ .Values.auth.tokenSecret }}
        || { echo 'secret {{ .Values.auth.tokenSecret }} is missing or empty' >&2; exit 1; };
        export RUNNER_TOKEN="$$(cat /run/secrets/{{ .Values.auth.tokenSecret }})";
        printf '%s\n' "$$RUNNER_CONFIG_TOML" > /etc/gitlab-runner/config.toml;
{{- if $cacheKeys }}
        for s in {{ .Values.cache.s3.accessKeySecret }} {{ .Values.cache.s3.secretKeySecret }}; do
        test -s "/run/secrets/$$s" || { echo "secret $$s is missing or empty" >&2; exit 1; };
        case "$$(cat "/run/secrets/$$s")" in *\'*) echo "secret $$s contains a single quote, which cannot be written into config.toml" >&2; exit 1;; esac;
        done;
        printf "      AccessKey = '%s'\n" "$$(cat /run/secrets/{{ .Values.cache.s3.accessKeySecret }})" >> /etc/gitlab-runner/config.toml;
        printf "      SecretKey = '%s'\n" "$$(cat /run/secrets/{{ .Values.cache.s3.secretKeySecret }})" >> /etc/gitlab-runner/config.toml;
{{- end }}
        exec gitlab-runner run --user=gitlab-runner --working-directory=/home/gitlab-runner

    environment:
      # This IS config.toml. It is written out at every container start, so a values change
      # takes effect on redeploy and a hand-edit inside the container never survives one.
      RUNNER_CONFIG_TOML: |
{{ join "\n" $toml | indent 8 }}
{{- range $key, $val := .Values.extraEnv }}
      {{ $key }}: {{ $val | quote }}
{{- end }}

    volumes:
      # The engine the runner creates job containers on. Root-equivalent on this node.
      - /var/run/docker.sock:/var/run/docker.sock
{{- if .Values.persistence.enabled }}
      - {{ .Values.persistence.volumePath | default .Values.persistence.volumeName }}:/etc/gitlab-runner
{{- end }}

    secrets:
{{- range $secrets }}
      - {{ . }}
{{- end }}

    # SIGQUIT is the image's own STOPSIGNAL and means "finish the running jobs, then exit";
    # pinned here so the graceful path does not depend on image metadata. Swarm's 10s
    # default grace period would SIGKILL the runner mid-build on every update.
    stop_signal: SIGQUIT
    stop_grace_period: {{ .Values.stopGracePeriod }}

{{- if .Values.healthcheck.enabled }}
    # Proves the process is up and its config parsed. curl is in the image (both the default
    # and the -alpine variants ship it).
    healthcheck:
      test:
        - CMD
        - curl
        - -fsS
        - -o
        - /dev/null
        - http://127.0.0.1:{{ .Values.metrics.port }}/metrics
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.replicas }}
      update_config:
        # stop-first because two runner tasks must not share one /etc/gitlab-runner volume,
        # even briefly: they would collide on .runner_system_id (see the replicas guard).
        order: stop-first
{{- if .Values.healthcheck.enabled }}
        {{- /* Swarm watches a task for `monitor` after CREATING it, and only counts a
               failure inside that window against the rollout. Shorter than the healthcheck
               needs to fail and a broken deploy reports success. */}}
        monitor: {{ .Values.healthcheck.monitor }}
{{- end }}
{{- /* The node pin is not tied to persistence here, unlike a database chart's: the runner
       drives ONE node's engine, so its job containers, image cache and job volumes live on
       that node whether or not /etc/gitlab-runner is persisted. */}}
{{- $constraints := list }}
{{- with .Values.persistence.nodeLabel }}
{{- $constraints = append $constraints (printf "node.labels.%s == true" .) }}
{{- end }}
{{- range .Values.placement.constraints }}
{{- $constraints = append $constraints . }}
{{- end }}
{{- if $constraints }}
      placement:
        constraints:
{{- range $constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- if or .Values.resources.limits.memory .Values.resources.reservations.memory }}
      resources:
{{- with .Values.resources.limits.memory }}
        limits:
          memory: {{ . | quote }}
{{- end }}
{{- with .Values.resources.reservations.memory }}
        reservations:
          memory: {{ . | quote }}
{{- end }}
{{- end }}
      restart_policy:
        condition: any
{{- with .Values.labels }}
      labels:
{{- range $key, $val := . }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}

{{- if and .Values.persistence.enabled (not .Values.persistence.volumePath) }}

volumes:
  {{ .Values.persistence.volumeName }}: {}
{{- end }}

secrets:
{{- range $secrets }}
  {{ . }}:
    external: true
{{- end }}
