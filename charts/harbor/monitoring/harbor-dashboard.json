        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(harbor_core_http_request_total{stack=\"$stack\",code=~\"5..\"}[5m])) / sum(rate(harbor_core_http_request_total{stack=\"$stack\"}[5m]))",
