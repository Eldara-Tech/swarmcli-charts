{{- /* Host-path persistence bind-mounts a host dir; a named-volume value must not be a
       path (docker compose would otherwise emit a cryptic error). */}}
{{- if and .Values.persistence.enabled (not .Values.persistence.volumePath) (contains "/" .Values.persistence.volumeName) -}}
{{- fail "persistence.volumeName is a Docker named-volume name and cannot contain '/'. To store models under a host directory, set persistence.volumePath instead." -}}
{{- end -}}
version: "3.9"

{{- /* Exposure mode drives networks, ports, labels and the public scheme. */}}
{{- $mode := .Values.exposure.mode }}
{{- $router := .Values.traefik.routerName | default .Release.Name }}
{{- $proxied := or (eq $mode "traefik") (eq $mode "none") }}
{{- $nets := list }}
{{- if $proxied }}{{ $nets = append $nets .Values.exposure.network }}{{- end }}

services:

  ollama:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

{{- if $nets }}
    networks:
{{- range $nets }}
      - {{ . }}
{{- end }}
{{- end }}

{{- if eq $mode "published" }}
    ports:
      - target: {{ .Values.service.port }}
        published: {{ .Values.publish.port }}
        protocol: tcp
        mode: {{ .Values.publish.mode }}
{{- end }}

{{- if .Values.persistence.enabled }}
    volumes:
{{- if .Values.persistence.volumePath }}
      - {{ .Values.persistence.volumePath }}:/root/.ollama
{{- else }}
      - {{ .Values.persistence.volumeName }}:/root/.ollama
{{- end }}
{{- end }}

    environment:
{{- /* Bind the API to all interfaces on service.port so it is reachable over the overlay /
       published port (the container default listens on loopback only). Kept in sync with
       service.port automatically; a user may override it via extraEnv. */}}
{{- if not (hasKey .Values.extraEnv "OLLAMA_HOST") }}
      OLLAMA_HOST: {{ printf "0.0.0.0:%v" .Values.service.port | quote }}
{{- end }}
{{- /* Enforce fully-offline operation: OLLAMA_NO_CLOUD stops Ollama routing any request to
       its cloud (ollama.com) models. On by default (offline:true) to match this chart's
       offline positioning; set offline:false, or override OLLAMA_NO_CLOUD via extraEnv. */}}
{{- if and .Values.offline (not (hasKey .Values.extraEnv "OLLAMA_NO_CLOUD")) }}
      OLLAMA_NO_CLOUD: "1"
{{- end }}
{{- range $key, $val := .Values.extraEnv }}
      {{ $key }}: {{ $val | quote }}
{{- end }}

{{- if .Values.healthcheck.enabled }}
    healthcheck:
      test:
        - CMD-SHELL
        - ollama list >/dev/null 2>&1
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.replicas }}
{{- /* The data-volume node pin travels with persistence: it exists only while a
       volume needs pinning, so persistence.enabled:false never leaves a task
       Pending on a missing node label. placement.constraints adds extras. */}}
{{- $constraints := list }}
{{- if and .Values.persistence.enabled .Values.persistence.nodeLabel }}
{{-   $constraints = append $constraints (printf "node.labels.%s == true" .Values.persistence.nodeLabel) }}
{{- end }}
{{- range .Values.placement.constraints }}
{{-   $constraints = append $constraints . }}
{{- end }}
{{- if $constraints }}
      placement:
        constraints:
{{- range $constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- /* One resources: block carries both the optional memory limit and, when GPU is on,
       the Swarm generic-resources reservation. GPU under `devices:` would validate but is
       a no-op in `docker stack deploy` — generic_resources is the Swarm-native request. */}}
{{- $limitMem := .Values.resources.limits.memory }}
{{- $resMem := .Values.resources.reservations.memory }}
{{- if or $limitMem $resMem .Values.gpu.enabled }}
      resources:
{{-   with $limitMem }}
        limits:
          memory: {{ . | quote }}
{{-   end }}
{{-   if or $resMem .Values.gpu.enabled }}
        reservations:
{{-     with $resMem }}
          memory: {{ . | quote }}
{{-     end }}
{{-     if .Values.gpu.enabled }}
          generic_resources:
            - discrete_resource_spec:
                kind: {{ .Values.gpu.kind | quote }}
                value: {{ .Values.gpu.count }}
{{-     end }}
{{-   end }}
{{- end }}
      restart_policy:
        condition: any
{{- if or (eq $mode "traefik") .Values.labels }}
      labels:
{{- if eq $mode "traefik" }}
        - "traefik.enable=true"
        - "traefik.swarm.network={{ .Values.exposure.network }}"
        - "traefik.constraint-label={{ .Values.traefik.constraintLabel }}"
        # HTTP router
        - "traefik.http.routers.{{ $router }}-http.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-http.entrypoints={{ .Values.traefik.entrypoints.http }}"
{{- if .Values.ingress.tls }}
        # Redirect plain HTTP to HTTPS, then terminate TLS on the HTTPS router.
        - "traefik.http.routers.{{ $router }}-http.middlewares={{ .Values.traefik.redirectMiddleware }}"
        - "traefik.http.routers.{{ $router }}-https.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-https.entrypoints={{ .Values.traefik.entrypoints.https }}"
        - "traefik.http.routers.{{ $router }}-https.tls=true"
        - "traefik.http.routers.{{ $router }}-https.tls.certresolver={{ .Values.traefik.certResolver }}"
{{- end }}
        - "traefik.http.services.{{ $router }}.loadbalancer.server.port={{ .Values.service.port }}"
{{- end }}
{{- range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}

{{- /* Opt-in model preload: a one-shot init service waits for the API, then POST /api/pulls
       each model so the stack comes up with models present. It shares ollama's network(s)
       ($nets) — in published mode both land on the stack's default overlay, in traefik/none
       modes both sit on exposure.network — and reaches the server by its stack-local name
       `ollama`. restart_policy condition:none => runs once and does not restart. */}}
{{- if .Values.models }}
{{- $port := .Values.service.port }}
{{- $parts := list "echo 'waiting for ollama...';" (printf "until curl -fsS http://ollama:%v/api/tags >/dev/null 2>&1; do sleep 5; done;" $port) }}
{{- range .Values.models }}
{{-   $parts = append $parts (printf "echo 'pulling %s...';" .) }}
{{-   $parts = append $parts (printf "curl -fsS http://ollama:%v/api/pull -d '{\"name\":\"%s\"}' >/dev/null;" $port .) }}
{{- end }}
{{- $parts = append $parts "echo 'all models ready.';" }}
  model-init:
    image: {{ .Values.modelInitImage }}
{{- if $nets }}
    networks:
{{- range $nets }}
      - {{ . }}
{{- end }}
{{- end }}
    command:
      - sh
      - -c
      - {{ join " " $parts | quote }}
    deploy:
      replicas: 1
      restart_policy:
        condition: none
{{- end }}

{{- if and .Values.persistence.enabled (not .Values.persistence.volumePath) }}

volumes:
  {{ .Values.persistence.volumeName }}: {}
{{- end }}

{{- if $nets }}

networks:
{{- range $nets }}
  {{ . }}:
    external: true
{{- end }}
{{- end }}
