{{- /* schedule.mode and platform.type are enum-checked by values.schema.json; this is the
       cross-field rule a schema states far less legibly than it reads here. */ -}}
{{- if and (not .Values.autodiscover) (not .Values.repositories) (not .Values.configName) }}
{{-   fail "set repositories: [owner/repo, ...], autodiscover: true, or supply them in the config file named by configName — Renovate would otherwise have nothing to do" }}
{{- end }}
{{- if and .Values.configVersion (not .Values.configName) }}
{{-   fail "configVersion names a version OF configName — set configName as well, or drop configVersion" }}
{{- end }}
{{- /* gitAuthor and extraEnv.RENOVATE_GIT_AUTHOR render into the SAME environment key, and a
       duplicate mapping key is a compose parse error rather than a last-one-wins. Say which
       one to drop here; the alternative is `mapping key already defined` at deploy time. */ -}}
{{- if and .Values.gitAuthor (index (.Values.extraEnv | default dict) "RENOVATE_GIT_AUTHOR") }}
{{-   fail "gitAuthor and extraEnv.RENOVATE_GIT_AUTHOR both set the same environment variable — keep gitAuthor and drop the extraEnv entry" }}
{{- end }}
{{- /* Renovate picks its config parser from the file's EXTENSION and exits
       `FATAL: Unsupported file type` on anything else, so configFormat — not the Docker
       config's name — is what makes the mount readable at all. One variable, so the env
       var and the mount target can never drift apart. */ -}}
{{- $configPath := printf "/run/configs/renovate-config.%s" .Values.configFormat }}
{{- /* A Swarm config is IMMUTABLE: `docker stack deploy` answers changed contents under an
       existing name by calling ConfigUpdate, which the daemon refuses with "only updates to
       Labels are allowed". Rotation — new contents under a new name — is the only mechanism
       Swarm offers, so configVersion is a suffix on the name rather than anything the
       running service sees. One variable again, so the mount and the declaration agree. */ -}}
{{- $configName := .Values.configName }}
{{- if and .Values.configName .Values.configVersion }}
{{-   $configName = printf "%s_%s" .Values.configName .Values.configVersion }}
{{- end }}
version: "3.9"

services:
  {{ .Chart.Name }}:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}
    # Renovate takes its token from RENOVATE_TOKEN and has no *_FILE convention, so the
    # secret is read here and exported. `$$` escapes the `$` for Compose, so the value
    # is resolved inside the container and never appears in the manifest or in
    # `docker inspect`. The image's own entrypoint still runs; this only replaces its
    # command.
    command:
      - bash
      - -c
      - >-
        set -eu;
        test -s /run/secrets/{{ .Values.auth.tokenSecret }}
        || { echo 'secret {{ .Values.auth.tokenSecret }} is empty' >&2; exit 1; };
        export RENOVATE_TOKEN="$$(cat /run/secrets/{{ .Values.auth.tokenSecret }})";
{{- if .Values.auth.githubComTokenSecret }}
        export GITHUB_COM_TOKEN="$$(cat /run/secrets/{{ .Values.auth.githubComTokenSecret }})";
{{- end }}
        exec renovate
    environment:
      RENOVATE_PLATFORM: {{ .Values.platform.type | quote }}
{{- if .Values.platform.endpoint }}
      RENOVATE_ENDPOINT: {{ .Values.platform.endpoint | quote }}
{{- end }}
{{- if .Values.gitAuthor }}
      RENOVATE_GIT_AUTHOR: {{ .Values.gitAuthor | quote }}
{{- end }}
{{- if .Values.autodiscover }}
      RENOVATE_AUTODISCOVER: "true"
{{- if .Values.autodiscoverFilter }}
      RENOVATE_AUTODISCOVER_FILTER: {{ .Values.autodiscoverFilter | quote }}
{{- end }}
{{- end }}
{{- if .Values.repositories }}
      RENOVATE_REPOSITORIES: {{ toJson .Values.repositories | quote }}
{{- end }}
{{- if .Values.configName }}
      RENOVATE_CONFIG_FILE: {{ $configPath }}
{{- end }}
{{- if .Values.dryRun }}
      RENOVATE_DRY_RUN: {{ .Values.dryRun | quote }}
{{- end }}
      LOG_LEVEL: {{ .Values.logLevel | quote }}
{{- range $key, $val := .Values.extraEnv }}
      {{ $key }}: {{ $val | quote }}
{{- end }}
    secrets:
      - {{ .Values.auth.tokenSecret }}
{{- if .Values.auth.githubComTokenSecret }}
      - {{ .Values.auth.githubComTokenSecret }}
{{- end }}
{{- if .Values.configName }}
    configs:
      - source: {{ $configName }}
        target: {{ $configPath }}
{{- end }}
    deploy:
{{- if eq .Values.schedule.mode "cronjob" }}
      # swarm-cronjob scales this to 1 on schedule and back to 0 when the run finishes.
      # It does nothing at all unless the swarm-cronjob chart is deployed on this swarm.
      replicas: 0
      restart_policy:
        condition: none
      labels:
        - "swarm.cronjob.enable=true"
        - "swarm.cronjob.schedule={{ .Values.schedule.cron }}"
        - "swarm.cronjob.skip-running={{ .Values.schedule.skipRunning }}"
{{- else }}
      # Renovate exits when a run finishes; `condition: any` makes Swarm start it again
      # after `delay`. That delay IS the schedule — there is no daemon and no cron.
      replicas: 1
      restart_policy:
        condition: any
        delay: {{ .Values.schedule.interval }}
{{- end }}
{{- if .Values.labels }}
{{-   if ne .Values.schedule.mode "cronjob" }}
      labels:
{{-   end }}
{{-   range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{-   end }}
{{- end }}
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . | quote }}
{{- end }}
{{- end }}
{{- if or .Values.resources.limits.memory .Values.resources.reservations.memory }}
      resources:
{{- if .Values.resources.limits.memory }}
        limits:
          memory: {{ .Values.resources.limits.memory | quote }}
{{- end }}
{{- if .Values.resources.reservations.memory }}
        reservations:
          memory: {{ .Values.resources.reservations.memory | quote }}
{{- end }}
{{- end }}

secrets:
  {{ .Values.auth.tokenSecret }}:
    external: true
{{- if .Values.auth.githubComTokenSecret }}
  {{ .Values.auth.githubComTokenSecret }}:
    external: true
{{- end }}
{{- if .Values.configName }}

configs:
  {{ $configName }}:
    external: true
{{- end }}
