      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{stack=\"$stack\",datname!~\"template.*\"}[$__rate_interval])) / (sum by (datname) (rate(pg_stat_database_blks_hit{stack=\"$stack\",datname!~\"template.*\"}[$__rate_interval])) + sum by (datname) (rate(pg_stat_database_blks_read{stack=\"$stack\",datname!~\"template.*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{datname}}",
          "range": true
        }
      ]
    },
