{{- $airbyteVersion := .Values.image.tag | default .Chart.AppVersion }}
{{- $serverImage := printf "%s:%s" .Values.image.repository $airbyteVersion }}
{{- $constraints := .Values.placement.constraints }}
{{- $dataConstraints := $constraints }}
{{- if .Values.persistence.nodeLabel }}{{ $dataConstraints = append $constraints (printf "node.labels.%s == true" .Values.persistence.nodeLabel) }}{{- end }}
{{- $proxyNetworks := list "airbyte" .Values.oauth2.redisNetwork }}
{{- if or (eq .Values.exposure.mode "traefik") (eq .Values.exposure.mode "none") }}{{ $proxyNetworks = append $proxyNetworks .Values.exposure.network }}{{- end }}
{{- $workloadNetworks := list .Values.database.network }}
{{- range .Values.workloadLauncher.extraNetworks }}{{ $workloadNetworks = append $workloadNetworks . }}{{- end }}
{{- $workloadNetworks = $workloadNetworks | uniq }}
{{- $router := .Release.Name }}
{{- $scheme := ternary "https" "http" .Values.exposure.tls }}
{{- $oauth := eq .Values.auth.mode "oauth2" }}
{{- $airbyteAuth := eq .Values.auth.mode "airbyte" }}
{{- if and (eq .Values.auth.mode "none") (eq .Values.exposure.mode "published") }}
{{- fail "auth.mode none cannot use exposure.mode published: the port would serve Airbyte, which runs any connector image it is given next to your database, to anyone who reaches it. Use exposure.mode traefik with traefik.basicAuthUsers, or exposure.mode none behind a proxy that authenticates." -}}
{{- end }}
{{- if and (eq .Values.auth.mode "none") (eq .Values.exposure.mode "traefik") (not .Values.traefik.basicAuthUsers) }}
{{- fail "auth.mode none with exposure.mode traefik needs traefik.basicAuthUsers: without it, anyone who resolves exposure.host can run connector images next to your database." -}}
{{- end }}
{{- /* auth.mode airbyte: Airbyte's own login. Every service that mints or checks Airbyte's
       JWTs (server, worker, workload-api-server, cron, connector builder) reads the same
       signing secret; the server also reads the admin password. */}}
{{- $jwtExport := "" }}
{{- if $airbyteAuth }}{{ $jwtExport = printf "export AB_JWT_SIGNATURE_SECRET=\"$$(cat /run/secrets/%s)\"; " .Values.auth.airbyte.jwtSecretName }}{{- end }}
{{- /* The public entry point is oauth2-proxy, or with auth.mode none/airbyte the server itself, plus
       a second router for the connector builder's path, which oauth2-proxy otherwise routes. */}}
{{- $serverPublic := and (not $oauth) (or (eq .Values.exposure.mode "traefik") (eq .Values.exposure.mode "none")) }}
{{- $authMiddleware := "" }}
{{- if .Values.traefik.basicAuthUsers }}{{ $authMiddleware = printf "%s-auth" $router }}{{- end }}
{{- $traefikLabels := dict "entry" (list) "builder" (list) }}
{{- if eq .Values.exposure.mode "traefik" }}
{{- $hostRule := printf "Host(`%s`)" .Values.exposure.host }}
{{- $targets := list (list "entry" $router $hostRule (ternary 4180 8001 $oauth)) }}
{{- if not $oauth }}{{ $targets = append $targets (list "builder" (printf "%s-builder" $router) (printf "%s && PathPrefix(`/api/v1/connector_builder/`)" $hostRule) 8080) }}{{- end }}
{{- range $targets }}
{{- $name := index . 1 }}
{{- $l := list "traefik.enable=true" (printf "traefik.swarm.network=%s" $.Values.exposure.network) (printf "traefik.constraint-label=%s" $.Values.traefik.constraintLabel) }}
{{- $l = append $l (printf "traefik.http.routers.%s-http.rule=%s" $name (index . 2)) }}
{{- $l = append $l (printf "traefik.http.routers.%s-http.entrypoints=%s" $name $.Values.traefik.entrypoints.http) }}
{{- if $.Values.exposure.tls }}
{{- $l = append $l (printf "traefik.http.routers.%s-http.middlewares=%s" $name $.Values.traefik.redirectMiddleware) }}
{{- $l = append $l (printf "traefik.http.routers.%s-https.rule=%s" $name (index . 2)) }}
{{- $l = append $l (printf "traefik.http.routers.%s-https.entrypoints=%s" $name $.Values.traefik.entrypoints.https) }}
{{- $l = append $l (printf "traefik.http.routers.%s-https.tls=true" $name) }}
{{- $l = append $l (printf "traefik.http.routers.%s-https.tls.certresolver=%s" $name $.Values.traefik.certResolver) }}
{{- $l = append $l (printf "traefik.http.routers.%s-https.middlewares=%s" $name (compact (list $authMiddleware (printf "%s-headers" $router)) | join ",")) }}
{{- else if $authMiddleware }}
{{- $l = append $l (printf "traefik.http.routers.%s-http.middlewares=%s" $name $authMiddleware) }}
{{- end }}
{{- $l = append $l (printf "traefik.http.services.%s.loadbalancer.server.port=%v" $name (index . 3)) }}
{{- $_ := set $traefikLabels (index . 0) $l }}
{{- end }}
{{- $entry := get $traefikLabels "entry" }}
{{- if $authMiddleware }}
{{- $entry = append $entry (printf "traefik.http.middlewares.%s.basicauth.users=%s" $authMiddleware .Values.traefik.basicAuthUsers) }}
{{- end }}
{{- if .Values.exposure.tls }}
{{- $entry = append $entry (printf "traefik.http.middlewares.%s-headers.headers.customrequestheaders.X-Forwarded-Host=%s" $router .Values.exposure.host) }}
{{- $entry = append $entry (printf "traefik.http.middlewares.%s-headers.headers.customrequestheaders.X-Forwarded-Proto=https" $router) }}
{{- end }}
{{- $_ := set $traefikLabels "entry" $entry }}
{{- end }}
{{- $entryLabels := get $traefikLabels "entry" }}
{{- range $key, $value := .Values.labels }}{{ $entryLabels = append $entryLabels (printf "%s=%s" $key $value) }}{{- end }}
version: "3.9"

services:
  db-migrations:
    image: {{ .Values.bootloader.image.repository }}:{{ .Values.bootloader.image.tag | default $airbyteVersion }}
    networks:
      - airbyte
      - {{ .Values.database.network }}
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
    configs:
      - source: fakek8s
        target: /tmp/FakeK8s.java
        mode: 0444
    environment:
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      RUN_DATABASE_MIGRATION_ON_STARTUP: "true"
      SECRET_PERSISTENCE: TESTING_CONFIG_DB_TABLE
      MICRONAUT_ENVIRONMENTS: docker
      AIRBYTE_AUTH_KUBERNETES_SECRET_CREATION_ENABLED: "false"
      KUBERNETES_NAMESPACE: default
    command:
      - /bin/bash
      - -c
      - |-
        export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})"
        export DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})"
        export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"
        cat > /tmp/bootloader.yml <<EOF
        datasources:
          local: { url: $${DATABASE_URL}, username: $${DATABASE_USER}, password: $${DATABASE_PASSWORD}, driver-class-name: org.postgresql.Driver }
          local-secrets: { url: $${DATABASE_URL}, username: $${DATABASE_USER}, password: $${DATABASE_PASSWORD}, driver-class-name: org.postgresql.Driver }
        EOF
        export MICRONAUT_CONFIG_FILES=/tmp/bootloader.yml
        mkdir -p /tmp/.kube
        printf '%s\n' 'apiVersion: v1' 'kind: Config' 'clusters:' '- cluster:' '    server: http://127.0.0.1:6443' '  name: fake' 'contexts:' '- context:' '    cluster: fake' '    namespace: default' '    user: fake' '  name: fake' 'current-context: fake' 'users:' '- name: fake' '  user:' '    token: fake' > /tmp/.kube/config
        export KUBECONFIG=/tmp/.kube/config HOME=/tmp
        java -cp "$$(ls airbyte-app/lib/postgresql-*.jar)" /tmp/FakeK8s.java &
        FAKE_K8S_PID=$$!
        trap 'kill $$FAKE_K8S_PID 2>/dev/null || true' EXIT
        for _attempt in $$(seq 1 300); do
          bash -c 'echo >/dev/tcp/127.0.0.1/6443' 2>/dev/null && break
          sleep 0.1
        done
        if ! bash -c 'echo >/dev/tcp/127.0.0.1/6443' 2>/dev/null; then
          echo 'FakeK8s did not start on 127.0.0.1:6443' >&2
          exit 1
        fi
        airbyte-app/bin/airbyte-bootloader
    deploy:
      replicas: 1
      restart_policy:
        condition: on-failure

{{- if $oauth }}

  oauth2-redis:
    image: {{ .Values.redis.image.repository }}:{{ .Values.redis.image.tag }}
    command: [redis-server, --appendonly, "yes"]
    networks:
      - {{ .Values.oauth2.redisNetwork }}
    volumes:
      - {{ .Values.persistence.oauthRedisVolume }}:/data
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $dataConstraints | indent 10 }}

  oauth2-proxy:
    image: {{ .Values.oauth2Proxy.image.repository }}:{{ .Values.oauth2Proxy.image.tag }}
    networks:
{{ toYaml $proxyNetworks | indent 6 }}
    secrets:
      - {{ .Values.oauth2.clientSecretName }}
      - {{ .Values.oauth2.cookieSecretName }}
    command:
      - --http-address=0.0.0.0:4180
      - --provider=keycloak-oidc
      - {{ printf "--oidc-issuer-url=%s" .Values.oauth2.issuerUrl | quote }}
      - {{ printf "--client-id=%s" .Values.oauth2.clientId | quote }}
      - --client-secret-file=/run/secrets/{{ .Values.oauth2.clientSecretName }}
      - --cookie-secret-file=/run/secrets/{{ .Values.oauth2.cookieSecretName }}
      - {{ printf "--cookie-name=%s" .Values.oauth2.cookieName | quote }}
      - --cookie-secure={{ .Values.exposure.tls }}
      - {{ printf "--cookie-domain=%s" .Values.exposure.host | quote }}
      - {{ printf "--redirect-url=%s://%s/oauth2/callback" $scheme .Values.exposure.host | quote }}
      - {{ printf "--email-domain=%s" .Values.oauth2.emailDomain | quote }}
      - --session-store-type=redis
      - --redis-connection-url=redis://oauth2-redis:6379
      - --set-xauthrequest=false
      - --pass-access-token=false
      - --pass-authorization-header=false
      - --pass-user-headers=false
      - --skip-provider-button=false
      - --reverse-proxy=true
      - {{ printf "--trusted-proxy-ip=%s" .Values.oauth2.trustedProxyIp | quote }}
      - --code-challenge-method=S256
      - {{ printf "--scope=%s" .Values.oauth2.scope | quote }}
      - --upstream=http://server:8001/
      - --upstream=http://connector-builder-server:8080/api/v1/connector_builder/
      - --skip-jwt-bearer-tokens={{ .Values.oauth2.skipJwtBearerTokens }}
      - {{ printf "--extra-jwt-issuers=%s=%s" .Values.oauth2.issuerUrl .Values.oauth2.clientId | quote }}
      - --ssl-insecure-skip-verify={{ .Values.oauth2.sslInsecureSkipVerify }}
      - --proxy-prefix=/oauth2
      - {{ printf "--whitelist-domain=%s" .Values.exposure.host | quote }}
      - --upstream-timeout={{ .Values.oauth2.upstreamTimeout }}
    deploy:
      replicas: 1
      restart_policy:
        condition: any
{{- with $entryLabels }}
      labels:
{{ toYaml . | indent 8 }}
{{- end }}
{{- if eq .Values.exposure.mode "published" }}
    ports:
      - target: 4180
        published: {{ .Values.exposure.publishedPort }}
        protocol: tcp
        mode: ingress
{{- end }}
{{- end }}

  workload-launcher:
    image: {{ .Values.workloadLauncher.image.repository }}:{{ .Values.workloadLauncher.image.tag | default $airbyteVersion }}
    user: "0"
    networks: [airbyte, {{ .Values.database.network }}]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    configs:
      - source: fakek8s
        target: /tmp/FakeK8s.java
        mode: 0444
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.storage.accessKeySecretName }}
      - {{ .Values.storage.secretKeySecretName }}
{{- with .Values.workloadLauncher.registryAuthSecretName }}
      - {{ . }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      STORAGE_TYPE: minio
      MINIO_ENDPOINT: {{ .Values.storage.endpoint | quote }}
      STORAGE_BUCKET_LOG: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_STATE: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_WORKLOAD_OUTPUT: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_ACTIVITY_PAYLOAD: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_AUDIT_LOGGING: {{ .Values.storage.bucket | quote }}
      S3_PATH_STYLE_ACCESS: "true"
      INTERNAL_API_HOST: http://server:8001
      WORKLOAD_API_HOST: http://workload-api-server:8007
{{- with .Values.workloadLauncher.registryAuthSecretName }}
      FAKEK8S_REGISTRY_AUTH_FILE: "/run/secrets/{{ . }}"
{{- end }}
      CONTROL_PLANE_TOKEN_ENDPOINT: http://server:8001/api/v1/dataplanes/token
      DATAPLANE_CLIENT_ID_SECRET_NAME: airbyte-auth-secrets
      DATAPLANE_CLIENT_ID_SECRET_KEY: dataplane-client-id
      DATAPLANE_CLIENT_SECRET_SECRET_NAME: airbyte-auth-secrets
      DATAPLANE_CLIENT_SECRET_SECRET_KEY: dataplane-client-secret
      FAKEK8S_OWNER: {{ .Release.Name | quote }}
      FAKEK8S_POD_NETWORK: "{{ .Release.Name }}_airbyte"
      FAKEK8S_POD_EXTRA_NETWORKS: {{ $workloadNetworks | join "," | quote }}
      WORKSPACE_ROOT: /data/workspace
      LOCAL_ROOT: /tmp/airbyte_local
      MICRONAUT_ENVIRONMENTS: docker
      JOB_KUBE_NAMESPACE: default
    command:
      - /bin/bash
      - -c
      - |-
        export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})"
        export DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})"
        export AWS_ACCESS_KEY_ID="$$(cat /run/secrets/{{ .Values.storage.accessKeySecretName }})"
        export AWS_SECRET_ACCESS_KEY="$$(cat /run/secrets/{{ .Values.storage.secretKeySecretName }})"
        export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"
        cat > /tmp/launcher-datasources.yml <<EOF
        datasources:
          config: { url: $${DATABASE_URL}, username: $${DATABASE_USER}, password: $${DATABASE_PASSWORD} }
          local: { url: $${DATABASE_URL}, username: $${DATABASE_USER}, password: $${DATABASE_PASSWORD} }
          local-secrets: { url: $${DATABASE_URL}, username: $${DATABASE_USER}, password: $${DATABASE_PASSWORD} }
        EOF
        export MICRONAUT_CONFIG_FILES=/tmp/launcher-datasources.yml
        mkdir -p /tmp/.kube
        printf '%s\n' 'apiVersion: v1' 'kind: Config' 'clusters:' '- cluster:' '    server: http://127.0.0.1:6443' '  name: fake' 'contexts:' '- context:' '    cluster: fake' '    namespace: default' '    user: fake' '  name: fake' 'current-context: fake' 'users:' '- name: fake' '  user:' '    token: fake' > /tmp/.kube/config
        export KUBECONFIG=/tmp/.kube/config HOME=/tmp
        mkdir -p /tmp/fakek8s-classes && javac /tmp/FakeK8s.java -d /tmp/fakek8s-classes
        FAKEK8S_CP="/tmp/fakek8s-classes:$$(ls airbyte-app/lib/postgresql-*.jar)"
        # db-migrations registers the dataplane on its first run and stores the credentials.
        until DATAPLANE_CLIENT_ID="$$(java -cp "$$FAKEK8S_CP" FakeK8s get-secret airbyte-auth-secrets dataplane-client-id)"; do
          echo 'Waiting for db-migrations to register the dataplane' >&2
          sleep 10
        done
        DATAPLANE_CLIENT_SECRET="$$(java -cp "$$FAKEK8S_CP" FakeK8s get-secret airbyte-auth-secrets dataplane-client-secret)"
        export DATAPLANE_CLIENT_ID DATAPLANE_CLIENT_SECRET
        java -cp "$$FAKEK8S_CP" FakeK8s & FAKE_K8S_PID=$$!
        trap 'kill $$FAKE_K8S_PID 2>/dev/null || true' EXIT
        exec airbyte-app/bin/airbyte-workload-launcher
    deploy:
      replicas: {{ .Values.workloadLauncher.replicas }}
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}
      resources:
        reservations:
          memory: {{ .Values.workloadLauncher.memoryReservation | quote }}
        limits:
          memory: {{ .Values.workloadLauncher.memoryLimit | quote }}

  workload-api-server:
    image: {{ .Values.workloadApiServer.image.repository }}:{{ .Values.workloadApiServer.image.tag | default $airbyteVersion }}
    networks: [airbyte, {{ .Values.database.network }}]
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.storage.accessKeySecretName }}
      - {{ .Values.storage.secretKeySecretName }}
{{- if $airbyteAuth }}
      - {{ .Values.auth.airbyte.jwtSecretName }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      STORAGE_TYPE: minio
      MINIO_ENDPOINT: {{ .Values.storage.endpoint | quote }}
      STORAGE_BUCKET_LOG: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_STATE: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_WORKLOAD_OUTPUT: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_ACTIVITY_PAYLOAD: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_AUDIT_LOGGING: {{ .Values.storage.bucket | quote }}
      S3_PATH_STYLE_ACCESS: "true"
      INTERNAL_API_HOST: http://server:8001
      MICRONAUT_ENVIRONMENTS: docker
{{- if $airbyteAuth }}
      API_AUTHORIZATION_ENABLED: "true"
{{- end }}
    command: [/bin/bash, -c, 'export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})" DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})" AWS_ACCESS_KEY_ID="$$(cat /run/secrets/{{ .Values.storage.accessKeySecretName }})" AWS_SECRET_ACCESS_KEY="$$(cat /run/secrets/{{ .Values.storage.secretKeySecretName }})"; export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"; {{ $jwtExport }}exec airbyte-app/bin/airbyte-workload-api-server']
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}

  server:
    image: {{ $serverImage }}
    networks: [airbyte, {{ .Values.database.network }}{{ if $serverPublic }}, {{ .Values.exposure.network }}{{ end }}]
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.storage.accessKeySecretName }}
      - {{ .Values.storage.secretKeySecretName }}
{{- if $airbyteAuth }}
      - {{ .Values.auth.airbyte.jwtSecretName }}
      - {{ .Values.auth.airbyte.passwordSecretName }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      AIRBYTE_EDITION: community
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      DATABASE_URL: {{ printf "jdbc:postgresql://%s:%v/%s" .Values.database.host .Values.database.port .Values.database.name | quote }}
      DATABASE_INITIALIZATION_TIMEOUT_MS: "600000"
      DATABASE_MAX_RETRIES: "30"
      DATABASE_RETRY_DELAY_MS: "10000"
      AIRBYTE_FLYWAY_CONFIGS_MINIMUM_MIGRATION_VERSION: {{ .Values.flyway.configsMinimumMigrationVersion | quote }}
      AIRBYTE_FLYWAY_JOBS_MINIMUM_MIGRATION_VERSION: {{ .Values.flyway.jobsMinimumMigrationVersion | quote }}
      ENTERPRISE_SOURCE_STUBS_URL: {{ .Values.connectorRegistry.enterpriseSourceStubsUrl | quote }}
      AIRBYTE_CONNECTOR_REGISTRY_ENTERPRISE_ENTERPRISE_SOURCE_STUBS_URL: {{ .Values.connectorRegistry.enterpriseSourceStubsUrl | quote }}
      STORAGE_TYPE: minio
      MINIO_ENDPOINT: {{ .Values.storage.endpoint | quote }}
      STORAGE_BUCKET_LOG: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_STATE: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_WORKLOAD_OUTPUT: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_ACTIVITY_PAYLOAD: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_AUDIT_LOGGING: {{ .Values.storage.bucket | quote }}
      S3_PATH_STYLE_ACCESS: "true"
      TEMPORAL_HOST: temporal:7233
      AIRBYTE_URL: {{ printf "%s://%s" $scheme .Values.exposure.host | quote }}
      AIRBYTE_API_HOST: http://localhost:8001/api/public
{{- if $airbyteAuth }}
      API_AUTHORIZATION_ENABLED: "true"
      # The login's token issuer; the cookies are Secure only when the public URL is https.
      WEBAPP_URL: {{ printf "%s://%s" $scheme .Values.exposure.host | quote }}
      AB_COOKIE_SECURE: {{ .Values.exposure.tls | quote }}
{{- end }}
      CONNECTOR_BUILDER_SERVER_API_HOST: http://connector-builder-server:8080
      WORKSPACE_ROOT: /data/workspace
      SECRET_PERSISTENCE: TESTING_CONFIG_DB_TABLE
    command: [/bin/bash, -c, 'export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})" DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})" AWS_ACCESS_KEY_ID="$$(cat /run/secrets/{{ .Values.storage.accessKeySecretName }})" AWS_SECRET_ACCESS_KEY="$$(cat /run/secrets/{{ .Values.storage.secretKeySecretName }})"; export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"; {{ $jwtExport }}{{ if $airbyteAuth }}export AB_INSTANCE_ADMIN_PASSWORD="$$(cat /run/secrets/{{ .Values.auth.airbyte.passwordSecretName }})"; {{ end }}exec airbyte-app/bin/airbyte-server']
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}
{{- if not $oauth }}
{{- with $entryLabels }}
      labels:
{{ toYaml . | indent 8 }}
{{- end }}
{{- if eq .Values.exposure.mode "published" }}
    ports:
      - target: 8001
        published: {{ .Values.exposure.publishedPort }}
        protocol: tcp
        mode: ingress
{{- end }}
{{- end }}

  connector-builder-server:
    image: {{ .Values.connectorBuilderServer.image.repository }}:{{ .Values.connectorBuilderServer.image.tag | default $airbyteVersion }}
    networks: [airbyte, {{ .Values.database.network }}{{ if $serverPublic }}, {{ .Values.exposure.network }}{{ end }}]
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.storage.accessKeySecretName }}
      - {{ .Values.storage.secretKeySecretName }}
{{- if $airbyteAuth }}
      - {{ .Values.auth.airbyte.jwtSecretName }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      ENTERPRISE_SOURCE_STUBS_URL: {{ .Values.connectorRegistry.enterpriseSourceStubsUrl | quote }}
      STORAGE_TYPE: minio
      MINIO_ENDPOINT: {{ .Values.storage.endpoint | quote }}
      STORAGE_BUCKET_LOG: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_STATE: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_WORKLOAD_OUTPUT: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_ACTIVITY_PAYLOAD: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_AUDIT_LOGGING: {{ .Values.storage.bucket | quote }}
      S3_PATH_STYLE_ACCESS: "true"
      TEMPORAL_HOST: temporal:7233
      WORKSPACE_ROOT: /data/workspace
{{- if $airbyteAuth }}
      # The UI sends Airbyte's login as the JWT cookie, never as a bearer token, and Micronaut
      # reads a token from a cookie only in cookie authentication mode, as the server runs.
      API_AUTHORIZATION_ENABLED: "true"
      MICRONAUT_SECURITY_AUTHENTICATION: cookie
      MICRONAUT_SECURITY_REDIRECT_ENABLED: "false"
{{- end }}
    command: [/bin/bash, -c, 'export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})" DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})" AWS_ACCESS_KEY_ID="$$(cat /run/secrets/{{ .Values.storage.accessKeySecretName }})" AWS_SECRET_ACCESS_KEY="$$(cat /run/secrets/{{ .Values.storage.secretKeySecretName }})"; {{ $jwtExport }}exec airbyte-app/bin/airbyte-connector-builder-server']
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}
{{- with get $traefikLabels "builder" }}
      labels:
{{ toYaml . | indent 8 }}
{{- end }}

  worker:
    image: {{ .Values.worker.image.repository }}:{{ .Values.worker.image.tag | default $airbyteVersion }}
    networks: [airbyte, {{ .Values.database.network }}]
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
      - {{ .Values.storage.accessKeySecretName }}
      - {{ .Values.storage.secretKeySecretName }}
{{- if $airbyteAuth }}
      - {{ .Values.auth.airbyte.jwtSecretName }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      ENTERPRISE_SOURCE_STUBS_URL: {{ .Values.connectorRegistry.enterpriseSourceStubsUrl | quote }}
      STORAGE_TYPE: minio
      MINIO_ENDPOINT: {{ .Values.storage.endpoint | quote }}
      STORAGE_BUCKET_LOG: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_STATE: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_WORKLOAD_OUTPUT: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_ACTIVITY_PAYLOAD: {{ .Values.storage.bucket | quote }}
      STORAGE_BUCKET_AUDIT_LOGGING: {{ .Values.storage.bucket | quote }}
      S3_PATH_STYLE_ACCESS: "true"
      TEMPORAL_HOST: temporal:7233
      AIRBYTE_URL: {{ printf "%s://%s" $scheme .Values.exposure.host | quote }}
      INTERNAL_API_HOST: http://server:8001
      WORKLOAD_API_HOST: http://workload-api-server:8007
      WORKSPACE_ROOT: /data/workspace
      SECRET_PERSISTENCE: TESTING_CONFIG_DB_TABLE
      SHOULD_RUN_CONNECTION_MANAGER_WORKFLOWS: "true"
      MICRONAUT_ENVIRONMENTS: docker,control-plane
    command: [/bin/bash, -c, 'export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})" DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})" AWS_ACCESS_KEY_ID="$$(cat /run/secrets/{{ .Values.storage.accessKeySecretName }})" AWS_SECRET_ACCESS_KEY="$$(cat /run/secrets/{{ .Values.storage.secretKeySecretName }})"; export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"; {{ $jwtExport }}exec airbyte-app/bin/airbyte-workers']
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}

  temporal:
    image: {{ .Values.temporal.image.repository }}:{{ .Values.temporal.image.tag }}
    command: [server, start-dev, --ip, 0.0.0.0, --db-filename, /home/temporal/temporal.db]
    networks: [airbyte]
    volumes:
      - {{ .Values.persistence.temporalVolume }}:/home/temporal
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $dataConstraints | indent 10 }}

  cron:
    image: {{ .Values.cron.image.repository }}:{{ .Values.cron.image.tag | default $airbyteVersion }}
    networks: [airbyte, {{ .Values.database.network }}]
    secrets:
      - {{ .Values.database.userSecretName }}
      - {{ .Values.database.passwordSecretName }}
{{- if $airbyteAuth }}
      - {{ .Values.auth.airbyte.jwtSecretName }}
{{- end }}
    environment:
      AIRBYTE_VERSION: {{ $airbyteVersion | quote }}
      AIRBYTE_EDITION: community
      DATABASE_HOST: {{ .Values.database.host | quote }}
      DATABASE_PORT: {{ .Values.database.port | quote }}
      DATABASE_DB: {{ .Values.database.name | quote }}
      CONFIGS_DATABASE_MINIMUM_FLYWAY_MIGRATION_VERSION: {{ .Values.flyway.configsMinimumMigrationVersion | quote }}
      MICRONAUT_ENVIRONMENTS: control-plane
      TEMPORAL_HOST: temporal:7233
      WORKLOAD_API_HOST: http://workload-api-server:8007
      WORKSPACE_ROOT: /data/workspace
      SECRET_PERSISTENCE: TESTING_CONFIG_DB_TABLE
    command: [/bin/bash, -c, 'export DATABASE_USER="$$(cat /run/secrets/{{ .Values.database.userSecretName }})" DATABASE_PASSWORD="$$(cat /run/secrets/{{ .Values.database.passwordSecretName }})"; export DATABASE_URL="jdbc:postgresql://$${DATABASE_HOST}:$${DATABASE_PORT}/$${DATABASE_DB}"; {{ $jwtExport }}exec airbyte-app/bin/airbyte-cron']
    deploy:
      replicas: 1
      placement:
        constraints:
{{ toYaml $constraints | indent 10 }}

volumes:
{{- if $oauth }}
  {{ .Values.persistence.oauthRedisVolume }}: {}
{{- end }}
  {{ .Values.persistence.temporalVolume }}: {}

configs:
  fakek8s:
    name: "{{ .Release.Name }}_fakek8s_{{ .Chart.Version }}{{ with .Values.fakeK8sConfigVersion }}_{{ . }}{{ end }}"
    file: files/FakeK8s.java

secrets:
  {{ .Values.database.userSecretName }}:
    external: true
  {{ .Values.database.passwordSecretName }}:
    external: true
  {{ .Values.storage.accessKeySecretName }}:
    external: true
  {{ .Values.storage.secretKeySecretName }}:
    external: true
{{- if $oauth }}
  {{ .Values.oauth2.clientSecretName }}:
    external: true
  {{ .Values.oauth2.cookieSecretName }}:
    external: true
{{- end }}
{{- with .Values.workloadLauncher.registryAuthSecretName }}
  {{ . }}:
    external: true
{{- end }}
{{- if $airbyteAuth }}
  {{ .Values.auth.airbyte.passwordSecretName }}:
    external: true
  {{ .Values.auth.airbyte.jwtSecretName }}:
    external: true
{{- end }}

networks:
  airbyte:
    driver: overlay
    attachable: true
{{- if $oauth }}
  {{ .Values.oauth2.redisNetwork }}: {}
{{- end }}
  {{ .Values.database.network }}:
    external: true
{{- if or (eq .Values.exposure.mode "traefik") (eq .Values.exposure.mode "none") }}
  {{ .Values.exposure.network }}:
    external: true
{{- end }}
