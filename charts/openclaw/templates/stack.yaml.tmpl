{{- /* Host-path persistence bind-mounts a host dir; a named-volume value must not be a
       path (docker compose would otherwise emit a cryptic error). */}}
{{- if and .Values.persistence.enabled (not .Values.persistence.dataPath) (contains "/" .Values.persistence.dataVolume) -}}
{{- fail "persistence.dataVolume is a Docker named-volume name and cannot contain '/'. To store data under a host directory, set persistence.dataPath instead." -}}
{{- end -}}
{{- if and .Values.persistence.enabled (not .Values.persistence.authPath) (contains "/" .Values.persistence.authVolume) -}}
{{- fail "persistence.authVolume is a Docker named-volume name and cannot contain '/'. To store the auth keys under a host directory, set persistence.authPath instead." -}}
{{- end -}}
version: "3.9"

{{- /* Exposure mode drives networks, ports, labels and the public scheme. */}}
{{- $mode := .Values.exposure.mode }}
{{- $router := .Values.traefik.routerName | default .Release.Name }}
{{- $proxied := or (eq $mode "traefik") (eq $mode "none") }}
{{- $publicTLS := and $proxied .Values.ingress.tls }}
{{- $scheme := ternary "https" "http" $publicTLS }}
{{- /* Public origin for the CORS default. Direct publish is reached on publish.port,
       so include it there; proxied modes sit behind the proxy on standard ports. */}}
{{- $publicOrigin := printf "%s://%s" $scheme .Values.ingress.host }}
{{- if eq $mode "published" }}{{ $publicOrigin = printf "%s://%s:%v" $scheme .Values.ingress.host .Values.publish.port }}{{- end }}
{{- $nets := list }}
{{- if $proxied }}{{ $nets = append $nets .Values.exposure.network }}{{- end }}
{{- if .Values.backend.enabled }}{{ $nets = append $nets .Values.backend.network }}{{- end }}
{{- /* Gateway launch. --bind/--port are passed as explicit flags; --allow-unconfigured
       clears OpenClaw's gateway.mode config guard so the gateway boots from empty state
       (configure it afterwards via the Control UI). When auth is on, the token is loaded
       from its mounted secret into OPENCLAW_GATEWAY_TOKEN (the env OpenClaw reads for
       gateway auth) at runtime, so the value stays out of the compose file / docker
       inspect. "$$" is the compose escape for a literal "$". */}}
{{- $launch := printf "exec openclaw gateway%s --bind %s --port %v" (ternary " --allow-unconfigured" "" .Values.allowUnconfigured) .Values.gatewayBind .Values.service.port }}
{{- $launch = printf "export OPENCLAW_GATEWAY_TOKEN=\"$$(cat /run/secrets/%s)\"; %s" .Values.auth.secretName $launch }}

services:

  gateway:
    image: {{ .Values.image.repository }}:{{ if .Values.image.tag }}{{ .Values.image.tag }}{{ else }}{{ .Chart.AppVersion }}{{ end }}

{{- if $nets }}
    networks:
{{- range $nets }}
      - {{ . }}
{{- end }}
{{- end }}

{{- if eq $mode "published" }}
    ports:
      - target: {{ .Values.service.port }}
        published: {{ .Values.publish.port }}
        protocol: tcp
        mode: {{ .Values.publish.mode }}
{{- end }}

{{- if .Values.persistence.enabled }}
    volumes:
      - {{ .Values.persistence.dataPath | default .Values.persistence.dataVolume }}:/home/node/.openclaw
      - {{ .Values.persistence.authPath | default .Values.persistence.authVolume }}:/home/node/.config/openclaw
{{- end }}

    secrets:
      - {{ .Values.auth.secretName }}

    # Container-internal paths are fixed by the image + the mount points above.
    environment:
      HOME: /home/node
      OPENCLAW_HOME: /home/node
      TERM: xterm-256color
      NODE_ENV: production
      OPENCLAW_STATE_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_CONFIG_PATH: /home/node/.openclaw/openclaw.json
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_DISABLE_BONJOUR: "1"
      OPENCLAW_ALLOWED_ORIGINS: {{ .Values.allowedOrigins | default $publicOrigin | quote }}
{{- range $key, $val := .Values.extraEnv }}
      {{ $key }}: {{ $val | quote }}
{{- end }}

    command:
      - sh
      - -c
      - {{ $launch | quote }}

{{- if .Values.healthcheck.enabled }}
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:{{ .Values.service.port }}/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
      interval: {{ .Values.healthcheck.interval }}
      timeout: {{ .Values.healthcheck.timeout }}
      retries: {{ .Values.healthcheck.retries }}
      start_period: {{ .Values.healthcheck.startPeriod }}
{{- end }}

    deploy:
      replicas: {{ .Values.replicas }}
{{- if .Values.placement.constraints }}
      placement:
        constraints:
{{- range .Values.placement.constraints }}
          - {{ . }}
{{- end }}
{{- end }}
{{- with .Values.resources.limits.memory }}
      resources:
        limits:
          memory: {{ . | quote }}
{{- end }}
      restart_policy:
        condition: any
{{- if or (eq $mode "traefik") .Values.labels }}
      labels:
{{- if eq $mode "traefik" }}
        - "traefik.enable=true"
        - "traefik.swarm.network={{ .Values.exposure.network }}"
        - "traefik.constraint-label={{ .Values.traefik.constraintLabel }}"
        # HTTP router
        - "traefik.http.routers.{{ $router }}-http.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-http.entrypoints={{ .Values.traefik.entrypoints.http }}"
{{- if .Values.ingress.tls }}
        # Redirect plain HTTP to HTTPS, then terminate TLS on the HTTPS router.
        - "traefik.http.routers.{{ $router }}-http.middlewares={{ .Values.traefik.redirectMiddleware }}"
        - "traefik.http.routers.{{ $router }}-https.rule=Host(`{{ .Values.ingress.host }}`)"
        - "traefik.http.routers.{{ $router }}-https.entrypoints={{ .Values.traefik.entrypoints.https }}"
        - "traefik.http.routers.{{ $router }}-https.tls=true"
        - "traefik.http.routers.{{ $router }}-https.tls.certresolver={{ .Values.traefik.certResolver }}"
{{- end }}
        - "traefik.http.services.{{ $router }}.loadbalancer.server.port={{ .Values.service.port }}"
{{- end }}
{{- range $key, $val := .Values.labels }}
        - "{{ $key }}={{ $val }}"
{{- end }}
{{- end }}

{{- if and .Values.persistence.enabled (or (not .Values.persistence.dataPath) (not .Values.persistence.authPath)) }}

volumes:
{{- if not .Values.persistence.dataPath }}
  {{ .Values.persistence.dataVolume }}: {}
{{- end }}
{{- if not .Values.persistence.authPath }}
  {{ .Values.persistence.authVolume }}: {}
{{- end }}
{{- end }}


secrets:
  {{ .Values.auth.secretName }}:
    external: true

{{- if $nets }}

networks:
{{- range $nets }}
  {{ . }}:
    external: true
{{- end }}
{{- end }}
