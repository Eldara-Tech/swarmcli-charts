      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rustfs_io_get_object_request_duration_seconds_bucket{stack=\"$stack\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "GetObject p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rustfs_s3_put_object_duration_ms_bucket{stack=\"$stack\"}[$__rate_interval]))) / 1000",
          "refId": "B",
          "legendFormat": "PutObject p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rustfs_http_server_request_duration_seconds_sum{stack=\"$stack\"}[$__rate_interval])) / sum(rate(rustfs_http_server_request_duration_seconds_count{stack=\"$stack\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "all requests, mean",
          "range": true
        }
